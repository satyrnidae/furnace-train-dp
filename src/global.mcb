# The shared nodes of the datapack advancement tree, the same files in every pack by satyrnidae so whichever loads first or last
# leaves the same result. Each pack adds its own node under global:satyrnidae/author.

advancement root {
  "display": {
    "title": {"translate": "global.advancement.root.title", "fallback": "Installed Datapacks"},
    "description": "",
    "icon": {
      "id": "minecraft:knowledge_book"
    },
    "background": "minecraft:block/gray_concrete",
    "show_toast": false,
    "announce_to_chat": false
  },
  "criteria": {
    "trigger": {
      "trigger": "minecraft:tick"
    }
  }
}

advancement satyrnidae/author {
  "display": {
    "title": {"translate": "global.advancement.satyrnidae.title", "fallback": "satyrnidae"},
    "description": {"translate": "global.advancement.satyrnidae.description", "fallback": "Datapacks Created by satyrnidae!"},
    "icon": {
      "id": "minecraft:player_head",
      "components": {
        "minecraft:profile": {
          "properties" : [ {
            "name" : "textures",
            "value" : ""
          } ]
        }
      }
    },
    "show_toast": false,
    "announce_to_chat": false
  },
  "parent": "global:root",
  "criteria": {
    "trigger": {
      "trigger": "minecraft:tick"
    }
  }
}
