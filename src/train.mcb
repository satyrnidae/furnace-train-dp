# Furnace minecart trains. Couple carts with a chain, cut them with shears, and a train follows its head with a chain block between
# each pair. A head furnace refuels from coal in a chest cart behind it, stops on unpowered powered rails and keeps the chunks around
# the train forceloaded, unless #chunkload on train.const is 0.
#
# Click handling: a function can't see the clicked entity, and a sneaking click on a minecart is a pass so no advancement fires. While
# a player sneaks with a coupler or shears, carts in reach get an interaction entity parked on them, and its interaction data is the click.
# Units: positions, gaps and speeds are scores in units of 1/64 block, see scale.js, saved motion and push are in ten thousandths.
# Tags, the sneaking predicate and the take_one item modifier are plain JSON under data/train. The couplers tag has optional entries
# that mcb tags can't express.

import ../scale.js
import objectives.js
import chains.js
import text/advancement.js
import text/uninstall.js

#region Setup
function load minecraft:load {
	# The temporaries and constants every module shares. Each module declares its own objectives in a load block of its own
	REPEAT (objectives.shared) as o {
		scoreboard objectives add train.<%o%> dummy
	}
	scoreboard players set #2 train.const 2
	scoreboard players set #-1 train.const -1
	scoreboard players set #16 train.const 16
	scoreboard players set #20 train.const 20
	scoreboard players set #100 train.const 100
	scoreboard players set #unit train.const <%UNIT%>
	scoreboard players set #spacing train.const <%u(2)%>
	# How far from either end of a chain a cart has to be to count as in the way, see follow.mcb
	scoreboard players set #end train.const <%u(1)%>
	scoreboard players set #chunk train.const <%16 * UNIT%>
	# Ticks a follower holds for a leader that went to another dimension, see follow.mcb
	scoreboard players set #holdmax train.const 60
	# Collision avoidance. Period in ticks between traces, reach in blocks, stop gap and hard hit speed in units, #10 is the cap divisor
	scoreboard players set #period train.const 20
	scoreboard players set #reach train.const 16
	scoreboard players set #stop train.const <%u(2.5)%>
	scoreboard players set #hit train.const <%u(0.1)%>
	scoreboard players set #10 train.const 10
	# Debug, 1 turns braking off so a head-on can be tested
	scoreboard players set #noavoid train.const 0
	# Chunk loading, 0 off and anything else on. Flip it with /scoreboard players set #chunkload train.const 0. Only set here when unset so a
	# reload keeps what was chosen. Off, the sweep frees every claim on the next pass, or once the grace below runs out after a reload
	execute unless score #chunkload train.const = #chunkload train.const run scoreboard players set #chunkload train.const 1
	# After a restart carts load a few ticks after the forced chunks do, so skip sweeping for a while, 20 passes of 5 ticks
	scoreboard players set #grace train.tmp 20
}
#endregion

# Removes everything the pack created, then disables it. Run as an operator: /function train:uninstall
# Carts stay as they are, unlinked. Chunks the pack forceloaded are released, except those that were forced before it.
function uninstall {
	tellraw @s <%uninstallText.start%>

	# Each module removes its own objectives, tags and entities through this tag
	function #train:uninstall

	data remove storage train:tmp tf
	data remove storage train:drop item

	REPEAT (objectives.shared) as o {
		scoreboard objectives remove train.<%o%>
	}
	scoreboard objectives remove train.eq.var
	scoreboard objectives remove train.eq.const

	# The result has to be read after the objectives are gone, so it goes in a storage value
	execute store success storage train:tmp uninstalled byte 1 run datapack disable "file/<%config.packName%>"
	execute unless data storage train:tmp {uninstalled:1b} run tellraw @s <%uninstallText.manual%>
	execute if data storage train:tmp {uninstalled:1b} run tellraw @s <%uninstallText.done%>
	data remove storage train:tmp uninstalled
}


function tick minecraft:tick {
	# Velocities of every furnace cart, first so everything below sees this tick's
	function train:sample/tick
	# Two furnaces of different trains meeting hard explode, after the sampler so velocities are this tick's
	function train:crash/tick
	# Look-ahead braking for heads, before head/rail so an unpowered rail still wins
	function train:avoid/tick

	# Clicks stored on the click catchers. Left clicks are swallowed while armed, the data is dropped so it doesn't pile up
	execute as @e[type=minecraft:interaction,tag=train.hit] at @s if data entity @s interaction run function train:click/hit
	execute as @e[type=minecraft:interaction,tag=train.hit] if data entity @s attack run data remove entity @s attack

	execute as @e[type=minecraft:furnace_minecart,tag=!train.follower,tag=!global.ignore,tag=!global.ignore.pos] at @s run function train:head/rail
	execute as @e[type=#train:carts,tag=train.follower,tag=!global.ignore,tag=!global.ignore.pos] at @s run function train:follow/tick
	execute as @e[type=minecraft:furnace_minecart,tag=!train.follower,tag=!global.ignore] run function train:fuel/check
	# Orphans are rare, the check runs once a second
	execute if score #p20 train.tmp matches 0 run execute as @e[type=minecraft:block_display,tag=train.chain] run function train:chain/check
	function train:click/arm

	scoreboard players add #gen train.tmp 1
	eq #p5 train.tmp = #gen train.tmp % 5
	eq #p20 train.tmp = #gen train.tmp % 20
	# Chunk claims are stamped with the pass tick and the sweep drops whatever wasn't touched. A cart covers 2 blocks in 5 ticks at most, and
	# its square reaches 7.5, so a pass every fifth tick keeps the chunks ahead of the train and halves the macro calls twice over
	execute if score #p5 train.tmp matches 0 run function train:chunks/pass
}

# The pack's node of the datapack advancement tree, under the author node of src/global.mcb
advancement root {
	"display": {
		"title": <%advText.rootTitle%>,
		"description": <%advText.rootDescription%>,
		"icon": {"id": "minecraft:furnace_minecart"},
		"show_toast": false,
		"announce_to_chat": false
	},
	"parent": "global:satyrnidae/author",
	"criteria": {
		"trigger": {"trigger": "minecraft:tick"}
	}
}

# Carts, anything the pack couples. Spawner and command block carts are included, they are carts to a train
tag entity_types carts {
	minecraft:minecart
	minecraft:furnace_minecart
	minecraft:chest_minecart
	minecraft:hopper_minecart
	minecraft:tnt_minecart
	minecraft:spawner_minecart
	minecraft:command_block_minecart
}

tag items fuel {
	minecraft:coal
	minecraft:charcoal
}

# Anything a sneaking player can couple or cut with
tag items tools {
	#train:couplers
	minecraft:shears
}

# Every chain item. Optional entries, an id a version doesn't have is skipped instead of failing the tag, which mcb tags can't say
json tags/item couplers {
	"values": <%JSON.stringify(chains.map((id) => ({ id: "minecraft:" + id, required: false })))%>
}

predicate sneaking {
	"type": "minecraft:entity_properties",
	"entity": "this",
	"predicate": { "flags": { "is_sneaking": true } }
}

# Takes one item from a stack
item_modifier take_one {
	"type": "minecraft:set_count",
	"count": -1,
	"add": true
}
