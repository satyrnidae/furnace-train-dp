# Furnace minecart trains. Couple carts with a chain, cut them with shears, and a train follows its head with a chain block between
# each pair. A head furnace refuels from coal in a chest cart behind it, stops on unpowered powered rails and keeps the chunks around
# the train forceloaded.
#
# Click handling: a function can't see the clicked entity, and a sneaking click on a minecart is a pass so no advancement fires. While
# a player sneaks with a coupler or shears, carts in reach get an interaction entity parked on them, and its interaction data is the click.
# Units: positions, gaps and speeds are scores in units of 1/64 block, see scale.js, saved motion and push are in ten thousandths.
# Tags, the sneaking predicate and the take_one item modifier are plain JSON under data/train. The couplers tag has optional entries
# that mcb tags can't express.

import ../scale.js

#region Setup
function load minecraft:load {
	# Per cart
	scoreboard objectives add train.id dummy
	scoreboard objectives add train.prev dummy
	scoreboard objectives add train.sel dummy
	scoreboard objectives add train.len dummy
	# Ticks in a row a follower's gap has been at the break distance
	scoreboard objectives add train.strain dummy
	# A follower's rails to its leader, see follow.mcb. Exit direction plus 1, units of path, and 1 while on a detour
	scoreboard objectives add train.cdir dummy
	scoreboard objectives add train.cgap dummy
	scoreboard objectives add train.cdet dummy
	# Last position of a leader, its speed is the change since the last sample, see follow.mcb
	scoreboard objectives add train.lpx dummy
	scoreboard objectives add train.lpz dummy
	scoreboard objectives add train.halt dummy
	scoreboard objectives add train.smx dummy
	scoreboard objectives add train.smz dummy
	scoreboard objectives add train.spx dummy
	scoreboard objectives add train.spz dummy
	# Furnace carts, see sample.mcb and avoid.mcb. Position last tick, velocity, last heading 0 N 1 E 2 S 3 W, gap to the next cart along the rail, tick of the last trace
	scoreboard objectives add train.ppx dummy
	scoreboard objectives add train.ppz dummy
	scoreboard objectives add train.svx dummy
	scoreboard objectives add train.svz dummy
	# The velocity of the tick before, the crash check reads both, see crash.mcb
	scoreboard objectives add train.pvx dummy
	scoreboard objectives add train.pvz dummy
	scoreboard objectives add train.dir dummy
	scoreboard objectives add train.gap dummy
	scoreboard objectives add train.chk dummy
	# Heading the last trace looked along, a different heading means an immediate trace. Reset by a resume for the same reason
	scoreboard objectives add train.tdir dummy
	# Per chunk, fake players named c<dimension>_<x>_<z>
	scoreboard objectives add train.cgen dummy
	scoreboard objectives add train.cpres dummy
	scoreboard objectives add train.tmp dummy
	scoreboard objectives add train.const dummy
	scoreboard players set #2 train.const 2
	scoreboard players set #-1 train.const -1
	scoreboard players set #16 train.const 16
	scoreboard players set #20 train.const 20
	scoreboard players set #100 train.const 100
	scoreboard players set #unit train.const <%UNIT%>
	scoreboard players set #spacing train.const <%u(2)%>
	scoreboard players set #chunk train.const <%16 * UNIT%>
	# Collision avoidance. Period in ticks between traces, reach in blocks, stop gap and hard hit speed in units, #10 is the cap divisor
	scoreboard players set #period train.const 20
	scoreboard players set #reach train.const 16
	scoreboard players set #stop train.const <%u(2.5)%>
	scoreboard players set #hit train.const <%u(0.1)%>
	scoreboard players set #10 train.const 10
	scoreboard players set #5 train.const 5
	# Debug, 1 turns braking off so a head-on can be tested
	scoreboard players set #noavoid train.const 0
	# Chunk loading, 1 on and 0 off. Flip it with /scoreboard players set #chunkload train.const 0. Only set here when unset so a reload keeps
	# what was chosen. Off, the sweep frees every claim next tick
	execute unless score #chunkload train.const = #chunkload train.const run scoreboard players set #chunkload train.const 1
	# Registry of chunks this pack forceloaded, survives reloads
	execute unless data storage train:chunks active run data modify storage train:chunks active set value []
	# After a restart carts load a few ticks after the forced chunks do, so skip sweeping for a while
	scoreboard players set #grace train.tmp 100
}
#endregion

function tick minecraft:tick {
	# Velocities of every furnace cart, first so everything below sees this tick's
	function train:sample/tick
	# Two furnaces of different trains meeting hard explode, after the sampler so velocities are this tick's
	function train:crash/tick
	# Look-ahead braking for heads, before head/rail so an unpowered rail still wins
	function train:avoid/tick

	# Clicks stored on the click catchers. Left clicks are swallowed while armed, the data is dropped so it doesn't pile up
	execute as @e[type=minecraft:interaction,tag=train.hit] at @s if data entity @s interaction run function train:click/hit
	execute as @e[type=minecraft:interaction,tag=train.hit] if data entity @s attack run data remove entity @s attack

	execute as @e[type=minecraft:furnace_minecart,tag=!train.follower] at @s run function train:head/rail
	execute as @e[type=#train:carts,tag=train.follower] at @s run function train:follow/tick
	execute as @e[type=minecraft:furnace_minecart,tag=!train.follower] run function train:fuel/check
	execute as @e[type=minecraft:block_display,tag=train.chain] run function train:chain/check
	function train:click/arm

	# Chunk claims are stamped with this tick, the sweep drops whatever wasn't touched
	scoreboard players add #gen train.tmp 1
	# The sweep runs even with chunk loading off, nothing is touched so it releases what was claimed
	execute if score #chunkload train.const matches 1 as @e[type=#train:carts,tag=!train.follower] if score @s train.id = @s train.id at @s run function train:chunks/head
	function train:chunks/sweep
}
