import ../../scale.js

# The chain between two carts. A block display of the chain item's block, same id as the follower so a pair stays matched.
# The string block state can't carry an axis, so the chain stays axis y. Its y scale is the length and a 90 degree x rotation lays it
# onto the display's forward direction, which is aimed at the leader every tick.

<%%
// Every chain item has a block of the same id. The ids are from memory except iron_chain, and a wrong one fails the function load
const chains = [
	"iron_chain",
	"copper_chain",
	"exposed_copper_chain",
	"weathered_copper_chain",
	"oxidized_copper_chain",
	"waxed_copper_chain",
	"waxed_exposed_copper_chain",
	"waxed_weathered_copper_chain",
	"waxed_oxidized_copper_chain",
];
// Sets the new display's block from the chain in that hand
for (const hand of ["mainhand", "offhand"]) {
	const lines = chains.map((id) => `\texecute if items entity @s weapon.${hand} minecraft:${id} run data modify entity @e[type=minecraft:block_display,tag=train.new,limit=1] block_state set value "minecraft:${id}"`);
	emit.mcb(`function state_${hand} {\n${lines.join("\n")}\n}`);
}
%%>

# As the player, after a successful link. The follower is still tagged train.target.
# teleport_duration 3 delays the display to match the client smoothing on minecarts, 1 ran visibly ahead of the carts
function spawn {
	execute at @e[tag=train.target,limit=1] run summon minecraft:block_display ~ ~0.4 ~ {Tags:["train.chain","train.new"],teleport_duration:3,interpolation_duration:1,transformation:{translation:[-0.5f,0.5f,-0.75f],left_rotation:[0.70711f,0f,0f,0.70711f],scale:[1f,1.5f,1f],right_rotation:[0f,0f,0f,1f]}}
	scoreboard players operation @e[tag=train.new,limit=1] train.id = @e[tag=train.target,limit=1] train.id
	# Block matches whichever chain was used, main hand first
	execute if items entity @s weapon.mainhand #train:couplers run function train:chain/state_mainhand
	execute unless items entity @s weapon.mainhand #train:couplers run function train:chain/state_offhand
	tag @e[tag=train.new] remove train.new
}

# As a follower, at it. Sets #seen train.tmp to 1 when its chain display is in the follower's dimension. A selector with a distance only
# looks in the dimension it runs in, and @s[distance] is no use, it compares coordinates and nothing else
function seen {
	scoreboard players set #seen train.tmp 0
	execute as @e[type=minecraft:block_display,tag=train.chain,distance=0..] if score @s train.id = #self train.tmp run scoreboard players set #seen train.tmp 1
}

# As a follower tagged train.hold_now, at it, after seen. A display in another dimension teleports to the follower, a Pos write can't change
# dimension
function hop {
	execute if score #seen train.tmp matches 0 as @e[type=minecraft:block_display,tag=train.chain] if score @s train.id = #self train.tmp run tp @s @e[tag=train.hold_now,limit=1]
}

# As a chain display, at its follower tagged train.hold_now. The leader is in another dimension. Keeps its last transformation, so the chain
# stays the length and facing it had, and hangs from the follower at the offset it had when the leader left. The offset is stored on the first
# tick, #first, and #fx #fy #fz is the follower, in units. A display already in another dimension has no offset to measure and is put on
# the follower
function hold {
	execute if score #first train.tmp matches 1 run function train:chain/hold_mark
	execute if score #seen train.tmp matches 0 run tp @s @e[tag=train.hold_now,limit=1]
	scoreboard players operation #cx train.tmp = #fx train.tmp
	scoreboard players operation #cx train.tmp += @s train.ox
	scoreboard players operation #cy train.tmp = #fy train.tmp
	scoreboard players operation #cy train.tmp += @s train.oy
	scoreboard players operation #cz train.tmp = #fz train.tmp
	scoreboard players operation #cz train.tmp += @s train.oz
	function train:chain/place
}

# As a chain display, on the first tick of a hold
function hold_mark {
	scoreboard players set @s train.ox 0
	scoreboard players set @s train.oy 0
	scoreboard players set @s train.oz 0
	execute if score #seen train.tmp matches 0 run return 0
	execute store result score @s train.ox run data get entity @s Pos[0] <%UNIT%>
	execute store result score @s train.oy run data get entity @s Pos[1] <%UNIT%>
	execute store result score @s train.oz run data get entity @s Pos[2] <%UNIT%>
	scoreboard players operation @s train.ox -= #fx train.tmp
	scoreboard players operation @s train.oy -= #fy train.tmp
	scoreboard players operation @s train.oz -= #fz train.tmp
}

# As a chain display. Puts it at #cx #cy #cz, in units
function place {
	execute store result entity @s Pos[0] double <%1 / UNIT%> run scoreboard players get #cx train.tmp
	execute store result entity @s Pos[1] double <%1 / UNIT%> run scoreboard players get #cy train.tmp
	execute store result entity @s Pos[2] double <%1 / UNIT%> run scoreboard players get #cz train.tmp
}

# As a chain display. #cx #cy #cz is the midpoint and #len the gap, in units, see scale.js
function apply {
	function train:chain/place
	# Yaw and pitch toward the leader, so local z runs along the link. Aimed from 0.4 lower, otherwise the raise over the cart base tilts it toward the leader's feet
	execute at @s positioned ~ ~-0.4 ~ facing entity @e[tag=train.lead_now,limit=1] feet run tp @s ~ ~0.4 ~ ~ ~
	# Stretched center to center, then trimmed to the gap minus 1, so each end sits 0.5 from its cart's center. That is the cart's back face
	# on the leader and its front face on the follower, and reads as attached
	scoreboard players operation #clen train.tmp = #len train.tmp
	scoreboard players remove #clen train.tmp <%u(1.0)%>
	execute if score #clen train.tmp matches ..<%u(0.2) - 1%> run scoreboard players set #clen train.tmp <%u(0.2)%>
	# Rotated box is x 0..1, y -1..0, z 0..len from the corner, so the translation is -0.5, 0.5, -len/2 to center it on the entity
	data modify storage train:tmp tf set value {translation:[-0.5f,0.5f,-0.75f],left_rotation:[0.70711f,0f,0f,0.70711f],scale:[1f,1.5f,1f],right_rotation:[0f,0f,0f,1f]}
	execute store result storage train:tmp tf.scale[1] float <%1 / UNIT%> run scoreboard players get #clen train.tmp
	execute store result storage train:tmp tf.translation[2] float -<%1 / (2 * UNIT)%> run scoreboard players get #clen train.tmp
	data modify entity @s transformation set from storage train:tmp tf
	data modify entity @s start_interpolation set value 0
}

# As a follower cart. Removes its chain display and gives the chain back
function kill {
	scoreboard players operation #cid train.tmp = @s train.id
	execute as @e[type=minecraft:block_display,tag=train.chain] if score @s train.id = #cid train.tmp run function train:chain/free
}

# As a chain display. The chain breaks where it hangs, with a sound and a puff of item particles, and drops the chain item it was made
# from. The one case that drops nothing is #nodrop, set by uncouple for a creative player's cut
function free {
	# The block id and the item id are the same string for every chain
	data modify storage train:drop item.id set from entity @s block_state
	execute at @s run playsound minecraft:block.chain.break block @a ~ ~ ~ 1 1
	execute at @s run function train:chain/particles with storage train:drop item
	execute unless score #nodrop train.tmp matches 1 at @s run function train:chain/drop_item with storage train:drop item
	kill @s
}

# Macro
function particles {
	$particle minecraft:item{item:{id:"$(id)"}} ~ ~ ~ 0.15 0.15 0.15 0.05 12
}

# Macro
function drop_item {
	$summon minecraft:item ~ ~ ~ {Item:{id:"$(id)",count:1}}
}

# As a chain display. Orphaned when its follower no longer exists, a cart that was destroyed breaks the link too
function check {
	scoreboard players operation #cid train.tmp = @s train.id
	scoreboard players set #alive train.tmp 0
	execute as @e[type=#train:carts,tag=train.follower] if score @s train.id = #cid train.tmp run scoreboard players set #alive train.tmp 1
	execute if score #alive train.tmp matches 0 run function train:chain/free
}
