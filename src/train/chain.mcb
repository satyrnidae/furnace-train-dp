# The chain between two carts. A block display of the chain item's block, same id as the follower so a pair stays matched.
# The string block state can't carry an axis, so the chain stays axis y. Its y scale is the length and a 90 degree x rotation lays it
# onto the display's forward direction, which is aimed at the leader every tick.

import ../../scale.js
import ../chains.js
import ../objectives.js

<%%
// Sets the new display's block from the chain in that hand
for (const hand of ["mainhand", "offhand"]) {
	const lines = chains.map((id) => `\texecute if items entity @s weapon.${hand} minecraft:${id} run data modify entity @e[type=minecraft:block_display,tag=train.new,limit=1] block_state set value "minecraft:${id}"`);
	emit.mcb(`function state_${hand} {\n${lines.join("\n")}\n}`);
}
%%>

# As the player, after a successful link. The follower is still tagged train.target.
# teleport_duration 3 delays the display to match the client smoothing on minecarts, 1 ran visibly ahead of the carts
function spawn {
	execute at @e[type=#train:carts,tag=train.target,limit=1] run summon minecraft:block_display ~ ~0.4 ~ {Tags:["train.chain","train.new"],teleport_duration:3,interpolation_duration:1,transformation:{translation:[-0.5f,0.5f,-0.75f],left_rotation:[0.70711f,0f,0f,0.70711f],scale:[1f,1.5f,1f],right_rotation:[0f,0f,0f,1f]}}
	scoreboard players operation @e[type=minecraft:block_display,tag=train.new,limit=1] train.id = @e[type=#train:carts,tag=train.target,limit=1] train.id
	# Block matches whichever chain was used, main hand first
	execute if items entity @s weapon.mainhand #train:couplers run function train:chain/state_mainhand
	execute unless items entity @s weapon.mainhand #train:couplers run function train:chain/state_offhand
	tag @e[type=minecraft:block_display,tag=train.new] remove train.new
}

# As a follower, at it. Sets #seen train.tmp to 1 when its chain display is in the follower's dimension. A selector with a distance only
# looks in the dimension it runs in, and @s[distance] is no use, it compares coordinates and nothing else
function seen {
	scoreboard players set #seen train.tmp 0
	execute as @e[type=minecraft:block_display,tag=train.chain,distance=0..] if score @s train.id = #self train.tmp run scoreboard players set #seen train.tmp 1
}

# As a follower tagged train.hold_now, at it, after seen. A display in another dimension teleports to the follower, a Pos write can't change
# dimension
function hop {
	execute if score #seen train.tmp matches 0 as @e[type=minecraft:block_display,tag=train.chain] if score @s train.id = #self train.tmp run tp @s @e[tag=train.hold_now,limit=1]
}

# As a chain display, at its follower tagged train.hold_now. The leader is in another dimension. Keeps its last transformation, so the chain
# stays the length and facing it had, and hangs from the follower at the offset it had when the leader left. The offset is stored on the first
# tick, #first, and #fx #fy #fz is the follower, in units. A display already in another dimension has no offset to measure and is put on
# the follower
function hold {
	execute if score #first train.tmp matches 1 run function train:chain/hold_mark
	execute if score #seen train.tmp matches 0 run tp @s @e[tag=train.hold_now,limit=1]
	scoreboard players operation #cx train.tmp = #fx train.tmp
	scoreboard players operation #cx train.tmp += @s train.ox
	scoreboard players operation #cy train.tmp = #fy train.tmp
	scoreboard players operation #cy train.tmp += @s train.oy
	scoreboard players operation #cz train.tmp = #fz train.tmp
	scoreboard players operation #cz train.tmp += @s train.oz
	function train:chain/place
}

# As a chain display, on the first tick of a hold
function hold_mark {
	scoreboard players set @s train.ox 0
	scoreboard players set @s train.oy 0
	scoreboard players set @s train.oz 0
	execute if score #seen train.tmp matches 0 run return 0
	execute store result score @s train.ox run data get entity @s Pos[0] <%UNIT%>
	execute store result score @s train.oy run data get entity @s Pos[1] <%UNIT%>
	execute store result score @s train.oz run data get entity @s Pos[2] <%UNIT%>
	scoreboard players operation @s train.ox -= #fx train.tmp
	scoreboard players operation @s train.oy -= #fy train.tmp
	scoreboard players operation @s train.oz -= #fz train.tmp
}

# As a chain display. Puts it at #cx #cy #cz, in units
function place {
	execute store result entity @s Pos[0] double <%1 / UNIT%> run scoreboard players get #cx train.tmp
	execute store result entity @s Pos[1] double <%1 / UNIT%> run scoreboard players get #cy train.tmp
	execute store result entity @s Pos[2] double <%1 / UNIT%> run scoreboard players get #cz train.tmp
}

# The chain is drawn from the follower's front edge to the leader's back edge, not center to center. Each end is half a block from its cart's
# center along the cart's own rail, toward the other cart, so on a corner the chain bows to the inside instead of cutting through the cart
# bodies. A cart's heading is its rail, a velocity says nothing about a cart at rest. A cart that isn't on a rail has no heading, its end
# stays at its center. Strain and breaking keep the real gap, this is only what is drawn.

<%%
// Where an end sits for each axis and which way along it, as an offset from the cart in blocks. Axis 1 is east west, 2 north south,
// 3 runs south west to north east, 4 runs south east to north west. A diagonal half block is 0.35355 on each axis. On an ascending rail the
// end is also 0.5 up or down, #sl is 1 when the positive side of the axis is the high one, -1 when it is the low one
const axes = [[1, 0.5, 0], [2, 0, 0.5], [3, 0.35355, 0.35355], [4, 0.35355, -0.35355]];
// A table of the offsets, running what follows `run` at the end. It runs at the cart, the end is a position
for (const [name, tail] of [
	["put", "run tp @e[type=minecraft:block_display,tag=train.chain_now,limit=1] ~ ~ ~"],
	["aim", "facing entity @e[type=minecraft:block_display,tag=train.chain_now,limit=1] feet run tp @e[type=minecraft:block_display,tag=train.chain_now,limit=1] ~ ~ ~ ~ ~"],
]) {
	const lines = [`	execute if score #at train.tmp matches 0 positioned ~ ~0.4 ~ ${tail}`];
	for (const [at, x, z] of axes) {
		for (const sg of [1, -1]) {
			for (const sl of at <= 2 ? [0, 1, -1] : [0]) {
				const y = Math.round((0.4 + sg * sl * 0.5) * 10) / 10;
				lines.push(`	execute if score #at train.tmp matches ${at} if score #sg train.tmp matches ${sg} if score #sl train.tmp matches ${sl} positioned ~${sg * x} ~${y} ~${sg * z} ${tail}`);
			}
		}
	}
	emit.mcb(`function ${name} {\n${lines.join("\n")}\n}`);
}
%%>

# As a cart, at it. #tx #tz is the way to the other cart. Sets #at to the axis of the rail under it, 0 for none, and #sg to 1 when the end is
# at the positive side of that axis, the side toward the other cart, and #sl to the slope along it
function axis {
	scoreboard players set #at train.tmp 0
	scoreboard players set #sl train.tmp 0
	execute if block ~ ~ ~ #minecraft:rails[shape=east_west] run scoreboard players set #at train.tmp 1
	execute if block ~ ~ ~ #minecraft:rails[shape=ascending_east] run scoreboard players set #at train.tmp 1
	execute if block ~ ~ ~ #minecraft:rails[shape=ascending_east] run scoreboard players set #sl train.tmp 1
	execute if block ~ ~ ~ #minecraft:rails[shape=ascending_west] run scoreboard players set #at train.tmp 1
	execute if block ~ ~ ~ #minecraft:rails[shape=ascending_west] run scoreboard players set #sl train.tmp -1
	execute if block ~ ~ ~ #minecraft:rails[shape=north_south] run scoreboard players set #at train.tmp 2
	execute if block ~ ~ ~ #minecraft:rails[shape=ascending_north] run scoreboard players set #at train.tmp 2
	execute if block ~ ~ ~ #minecraft:rails[shape=ascending_north] run scoreboard players set #sl train.tmp -1
	execute if block ~ ~ ~ #minecraft:rails[shape=ascending_south] run scoreboard players set #at train.tmp 2
	execute if block ~ ~ ~ #minecraft:rails[shape=ascending_south] run scoreboard players set #sl train.tmp 1
	execute if block ~ ~ ~ #minecraft:rails[shape=south_east] run scoreboard players set #at train.tmp 4
	execute if block ~ ~ ~ #minecraft:rails[shape=north_west] run scoreboard players set #at train.tmp 4
	execute if block ~ ~ ~ #minecraft:rails[shape=south_west] run scoreboard players set #at train.tmp 3
	execute if block ~ ~ ~ #minecraft:rails[shape=north_east] run scoreboard players set #at train.tmp 3
	# Along the axis, the vector to the other cart as a dot product
	scoreboard players set #dot train.tmp 0
	execute if score #at train.tmp matches 1 run eq #dot train.tmp = #tx train.tmp
	execute if score #at train.tmp matches 2 run eq #dot train.tmp = #tz train.tmp
	execute if score #at train.tmp matches 3 run eq #dot train.tmp = #tx train.tmp + #tz train.tmp
	execute if score #at train.tmp matches 4 run eq #dot train.tmp = #tx train.tmp - #tz train.tmp
	scoreboard players set #sg train.tmp 1
	execute if score #dot train.tmp matches ..-1 run scoreboard players set #sg train.tmp -1
}

# As the leader, at it. The chain display is put at the leader's end, its back edge
function leader_end {
	eq #tx train.tmp = 0 - #dx train.tmp
	eq #tz train.tmp = 0 - #dz train.tmp
	function train:chain/axis
	function train:chain/put
}

# As a follower, at it, with the leader tagged train.lead_now and #dx #dz #len3 from the sample. Draws its chain. The display goes to the
# leader's end, then to the follower's end, looking at the leader's from there, which aims it along the link. The ends are read off it
function render {
	execute as @e[type=minecraft:block_display,tag=train.chain,distance=..12] if score @s train.id = #self train.tmp run tag @s add train.chain_now
	execute unless entity @e[type=minecraft:block_display,tag=train.chain_now,limit=1] run return 0
	execute as @e[type=#train:carts,tag=train.lead_now,limit=1] at @s run function train:chain/leader_end
	execute store result score #bx train.tmp run data get entity @e[type=minecraft:block_display,tag=train.chain_now,limit=1] Pos[0] <%UNIT%>
	execute store result score #by train.tmp run data get entity @e[type=minecraft:block_display,tag=train.chain_now,limit=1] Pos[1] <%UNIT%>
	execute store result score #bz train.tmp run data get entity @e[type=minecraft:block_display,tag=train.chain_now,limit=1] Pos[2] <%UNIT%>
	eq #tx train.tmp = #dx train.tmp
	eq #tz train.tmp = #dz train.tmp
	function train:chain/axis
	function train:chain/aim
	execute store result score #ax train.tmp run data get entity @e[type=minecraft:block_display,tag=train.chain_now,limit=1] Pos[0] <%UNIT%>
	execute store result score #ay train.tmp run data get entity @e[type=minecraft:block_display,tag=train.chain_now,limit=1] Pos[1] <%UNIT%>
	execute store result score #az train.tmp run data get entity @e[type=minecraft:block_display,tag=train.chain_now,limit=1] Pos[2] <%UNIT%>
	# The midpoint of the ends, and their 3D distance. Newton seeded at the gap between the carts, the ends are never farther apart than
	# that plus 1, and it is never 0
	eq #cx train.tmp = (#ax train.tmp + #bx train.tmp) / 2
	eq #cy train.tmp = (#ay train.tmp + #by train.tmp) / 2
	eq #cz train.tmp = (#az train.tmp + #bz train.tmp) / 2
	eq #ex train.tmp = #bx train.tmp - #ax train.tmp
	eq #ey train.tmp = #by train.tmp - #ay train.tmp
	eq #ez train.tmp = #bz train.tmp - #az train.tmp
	eq #dsq3 train.tmp = #ex train.tmp * #ex train.tmp + #ey train.tmp * #ey train.tmp + #ez train.tmp * #ez train.tmp
	function train:follow/sqrt3
	function train:follow/sqrt3
	function train:follow/sqrt3
	execute as @e[type=minecraft:block_display,tag=train.chain_now,limit=1] run function train:chain/apply
	tag @e[type=minecraft:block_display,tag=train.chain_now] remove train.chain_now
}

# As a chain display. #cx #cy #cz is the midpoint and #len3 the distance between its ends, in units, see scale.js. Its facing is already
# set, the length never goes under 0.2 so ends that cross don't turn the box inside out
function apply {
	function train:chain/place
	scoreboard players operation #clen train.tmp = #len3 train.tmp
	execute if score #clen train.tmp matches ..<%u(0.2) - 1%> run scoreboard players set #clen train.tmp <%u(0.2)%>
	# Rotated box is x 0..1, y -1..0, z 0..len from the corner, so the translation is -0.5, 0.5, -len/2 to center it on the entity
	data modify storage train:tmp tf set value {translation:[-0.5f,0.5f,-0.75f],left_rotation:[0.70711f,0f,0f,0.70711f],scale:[1f,1.5f,1f],right_rotation:[0f,0f,0f,1f]}
	execute store result storage train:tmp tf.scale[1] float <%1 / UNIT%> run scoreboard players get #clen train.tmp
	execute store result storage train:tmp tf.translation[2] float -<%1 / (2 * UNIT)%> run scoreboard players get #clen train.tmp
	data modify entity @s transformation set from storage train:tmp tf
	data modify entity @s start_interpolation set value 0
}

# As a follower cart. Removes its chain display and gives the chain back
function kill {
	scoreboard players operation #cid train.tmp = @s train.id
	execute as @e[type=minecraft:block_display,tag=train.chain] if score @s train.id = #cid train.tmp run function train:chain/free
}

# As a chain display. The chain breaks where it hangs, with a sound and a puff of item particles, and drops the chain item it was made
# from. The one case that drops nothing is #nodrop, set by uncouple for a creative player's cut
function free {
	# The block id and the item id are the same string for every chain
	data modify storage train:drop item.id set from entity @s block_state
	execute at @s run playsound minecraft:block.chain.break block @a ~ ~ ~ 1 1
	execute at @s run function train:chain/particles with storage train:drop item
	execute unless score #nodrop train.tmp matches 1 at @s run function train:chain/drop_item with storage train:drop item
	kill @s
}

# Macro
function particles {
	$particle minecraft:item{item:{id:"$(id)"}} ~ ~ ~ 0.15 0.15 0.15 0.05 12
}

# Macro
function drop_item {
	$summon minecraft:item ~ ~ ~ {Item:{id:"$(id)",count:1}}
}

# As a chain display. Orphaned when its follower no longer exists, a cart that was destroyed breaks the link too
function check {
	scoreboard players operation #cid train.tmp = @s train.id
	scoreboard players set #alive train.tmp 0
	execute as @e[type=#train:carts,tag=train.follower] if score @s train.id = #cid train.tmp run scoreboard players set #alive train.tmp 1
	execute if score #alive train.tmp matches 0 run function train:chain/free
}

# Where a display hangs from its follower while the leader is away, in units
function load minecraft:load {
	REPEAT (objectives.chain) as o {
		scoreboard objectives add train.<%o%> dummy
	}
}

# Breaks every chain display without dropping anything
function uninstall train:uninstall {
	kill @e[type=minecraft:block_display,tag=train.chain]
	REPEAT (objectives.chain) as o {
		scoreboard objectives remove train.<%o%>
	}
}
