# TODO: Manual review needed. Please delete this line after review.
# Rail path tracer. From a head's block it follows the rails ahead the way a cart would, one block at a time, and reports the distance
# along the path to the first cart that isn't part of the head's own train. Curves, slopes and powered rails are followed exactly.
# Rails are deterministic: a cart takes the shape of the block it is on, so there is never a choice to model.
# Heading is 0 N, 1 E, 2 S, 3 W. A cart heading h enters a rail through the edge opposite h and leaves through the shape's other edge.
# A shape that doesn't have the entry edge can't be entered that way and the trace ends clear, same for a missing rail or modded shape.
# Next block after leaving: through the high edge of a slope it is one up, anywhere else it is level or one down.

# As a cart, at it. Needs @s train.dir. Leaves #gap train.tmp, thousandths of a block along the rail path to the first foreign cart,
# 99000 when clear. Tags the cart's own train train.mine for the length of the trace and always untags
function run {
	function train:trace/mark
	scoreboard players set #gap train.tmp 99000
	scoreboard players set #n train.tmp 0
	scoreboard players operation #h train.tmp = @s train.dir
	execute at @s align xyz run function train:trace/step
	function train:trace/unmark
}

# One block of the walk, positioned at the block corner. #n is the number of blocks walked, #h the heading
<%%
const OPP = { n: "s", e: "w", s: "n", w: "e" };
const HEAD = { n: 0, e: 1, s: 2, w: 3 };
const SHAPES = {
	north_south: { edges: ["n", "s"] },
	east_west: { edges: ["e", "w"] },
	ascending_east: { edges: ["w", "e"], high: "e" },
	ascending_west: { edges: ["e", "w"], high: "w" },
	ascending_north: { edges: ["s", "n"], high: "n" },
	ascending_south: { edges: ["n", "s"], high: "s" },
	south_east: { edges: ["s", "e"] },
	south_west: { edges: ["s", "w"] },
	north_west: { edges: ["n", "w"] },
	north_east: { edges: ["n", "e"] },
};
const table = [];
for (const [shape, s] of Object.entries(SHAPES)) {
	for (const h of ["n", "e", "s", "w"]) {
		const i = s.edges.indexOf(OPP[h]);
		if (i < 0) continue;
		const exit = s.edges[1 - i];
		const kind = s.high === exit ? "up" : "go";
		table.push(`\texecute if score #h train.tmp matches ${HEAD[h]} if block ~ ~ ~ #minecraft:rails[shape=${shape}] run return run function train:trace/${kind}_${exit}`);
	}
}
const head = [
	"\texecute unless block ~ ~ ~ #minecraft:rails run return 0",
	"\texecute if entity @e[type=#train:carts,tag=!train.mine,dx=0,dy=0,dz=0] run return run function train:trace/hit",
	"\texecute if score #n train.tmp >= #reach train.const run return 0",
	"\tscoreboard players add #n train.tmp 1",
];
emit.mcb("function step {\n" + head.concat(table).join("\n") + "\n}");

// Moves one block in a direction and keeps walking. go tries the same level then one down, up tries one up only
const MOVE = { n: [0, -1], e: [1, 0], s: [0, 1], w: [-1, 0] };
for (const [d, [dx, dz]] of Object.entries(MOVE)) {
	const walk = (dy) => `\texecute positioned ~${dx} ~${dy} ~${dz} if block ~ ~ ~ #minecraft:rails run return run function train:trace/step`;
	const set = `\tscoreboard players set #h train.tmp ${HEAD[d]}`;
	emit.mcb("function go_" + d + " {\n" + [set, walk(0), walk(-1)].join("\n") + "\n}");
	emit.mcb("function up_" + d + " {\n" + [set, walk(1)].join("\n") + "\n}");
}
%%>

# A foreign cart is in this block
function hit {
	scoreboard players operation #gap train.tmp = #n train.tmp
	scoreboard players operation #gap train.tmp *= #1000 train.const
}

# As a cart. Tags its own train, the cart and everything following it
function mark {
	execute unless score @s train.id = @s train.id run function train:link/assign_id
	tag @s add train.mine
	scoreboard players operation #cur train.tmp = @s train.id
	function train:trace/mark_walk
}

function mark_walk {
	execute as @e[type=#train:carts,tag=train.follower] if score @s train.prev = #cur train.tmp run function train:trace/mark_visit
}

function mark_visit {
	tag @s add train.mine
	scoreboard players operation #cur train.tmp = @s train.id
	function train:trace/mark_walk
}

function unmark {
	tag @e[tag=train.mine] remove train.mine
}
