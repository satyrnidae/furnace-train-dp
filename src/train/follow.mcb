import ../../scale.js

# Follower control. Each follower copies the speed of the cart ahead along the line to it, plus a correction toward 2 blocks of
# spacing, and gets that written as its Motion every tick. Rail physics keeps the speed and puts the direction on the track.
# The leader's speed is its real displacement since last tick. The Motion tag of a jammed cart holds whatever piled up, 3+ blocks
# per tick was seen, and copying that made carts ram each other.
# Spacing is 2 blocks because vanilla carts shove each other when hitboxes inflated by 0.2 touch, about 1.4 apart, and that fights the controller.
# The pull is toward the leader in a straight line, so on track that doubles back, a hairpin or a sharp corner, it can point against the
# follower's own track and the rail flips the cart backward. Where the follower's rails lead to the leader and the line isn't roughly
# along the way out of its block, the follower drives along the rails instead, never backward. See align and detour below. A leader on
# a parallel track is not connected by rails, the line is all there is, and the follower is pulled along it, backward if need be.

# As a follower cart, at the follower
function tick {
	scoreboard players operation #prev train.tmp = @s train.prev
	scoreboard players operation #self train.tmp = @s train.id
	scoreboard players set #found train.tmp 0
	execute store result score #fx train.tmp run data get entity @s Pos[0] <%UNIT%>
	execute store result score #fy train.tmp run data get entity @s Pos[1] <%UNIT%>
	execute store result score #fz train.tmp run data get entity @s Pos[2] <%UNIT%>
	execute as @e[type=#train:carts,distance=..8] if score @s train.id = #prev train.tmp run function train:follow/leader_sample
	execute if score #found train.tmp matches 0 run return run function train:link/unlink

	# Vector to the leader
	scoreboard players operation #dx train.tmp = #lx train.tmp
	scoreboard players operation #dx train.tmp -= #fx train.tmp
	scoreboard players operation #dz train.tmp = #lz train.tmp
	scoreboard players operation #dz train.tmp -= #fz train.tmp
	scoreboard players operation #dsq train.tmp = #dx train.tmp
	scoreboard players operation #dsq train.tmp *= #dx train.tmp
	scoreboard players operation #t train.tmp = #dz train.tmp
	scoreboard players operation #t train.tmp *= #dz train.tmp
	scoreboard players operation #dsq train.tmp += #t train.tmp

	# Gap length, newton from last tick's value. Never lets the estimate collapse to 0, newton can't recover from that
	scoreboard players operation #len train.tmp = @s train.len
	execute if score #len train.tmp matches ..<%u(0.1) - 1%> run scoreboard players set #len train.tmp <%u(1.5)%>
	function train:follow/sqrt
	function train:follow/sqrt
	execute if score #len train.tmp matches ..<%u(0.1) - 1%> run scoreboard players set #len train.tmp <%u(0.1)%>
	scoreboard players operation @s train.len = #len train.tmp

	# Chain strain. A gap of 5 blocks or more for 5 ticks in a row breaks the chain, a single tick of it is only a blip
	execute if score #len train.tmp matches <%u(5)%>.. run scoreboard players add @s train.strain 1
	execute unless score #len train.tmp matches <%u(5)%>.. run scoreboard players set @s train.strain 0
	execute if score @s train.strain matches 5.. run return run function train:follow/snap
	# A cart of the chain order's wrong side in the way breaks the chain too, see blocked
	function train:follow/blocked
	execute if score #blocked train.tmp matches 1 run return run function train:follow/snap

	# Rails to the leader. The chord is a straight line, so on a hairpin it points back along the follower's own track, and the rail
	# flips a cart whose Motion opposes it. Whether the follower's rails lead to the leader, and how far, is walked every 5 ticks, every tick
	# while on a detour. A parallel track never connects, and there the chord is the only signal, reversal included
	scoreboard players operation #slot train.tmp = @s train.id
	scoreboard players operation #slot train.tmp += #gen train.tmp
	scoreboard players operation #slot train.tmp %= #5 train.const
	# Self compare is the unset check, a missing score never equals anything, so a fresh follower walks at once
	execute unless score @s train.cdir = @s train.cdir run scoreboard players set #slot train.tmp 0
	execute if score @s train.cdet matches 1 run scoreboard players set #slot train.tmp 0
	scoreboard players set #fresh train.tmp 0
	execute if score #slot train.tmp matches 0 run function train:follow/connect
	# A detour is a chord that isn't along the way out of the block toward the leader. The rails may have changed since the last walk, so
	# one that looks like a detour gets a fresh walk before it is believed
	function train:follow/align
	execute if score #detour train.tmp matches 1 if score #fresh train.tmp matches 0 run function train:follow/connect
	execute if score #detour train.tmp matches 1 if score #fresh train.tmp matches 1 run function train:follow/align
	scoreboard players operation @s train.cdet = #detour train.tmp

	# Chain display at the midpoint, raised 0.4
	scoreboard players operation #cx train.tmp = #fx train.tmp
	scoreboard players operation #cx train.tmp += #lx train.tmp
	scoreboard players operation #cx train.tmp /= #2 train.const
	scoreboard players operation #cy train.tmp = #fy train.tmp
	scoreboard players operation #cy train.tmp += #ly train.tmp
	scoreboard players operation #cy train.tmp /= #2 train.const
	scoreboard players add #cy train.tmp <%u(0.4)%>
	scoreboard players operation #cz train.tmp = #fz train.tmp
	scoreboard players operation #cz train.tmp += #lz train.tmp
	scoreboard players operation #cz train.tmp /= #2 train.const
	execute as @e[type=minecraft:block_display,tag=train.chain,distance=..12] if score @s train.id = #self train.tmp run function train:chain/apply
	tag @e[tag=train.lead_now] remove train.lead_now

	# Speed along the heading to the leader is the leader's speed on that heading plus a correction toward the spacing.
	# Gap over spacing speeds up, gap under slows or backs off, so energy never builds up down the train
	scoreboard players operation #sp train.tmp = #vx train.tmp
	scoreboard players operation #sp train.tmp *= #dx train.tmp
	scoreboard players operation #t train.tmp = #vz train.tmp
	scoreboard players operation #t train.tmp *= #dz train.tmp
	scoreboard players operation #sp train.tmp += #t train.tmp
	scoreboard players operation #sp train.tmp /= #len train.tmp
	scoreboard players operation #err train.tmp = #len train.tmp
	scoreboard players operation #err train.tmp -= #spacing train.const
	# Too close backs off 2.5x harder than too far catches up
	scoreboard players set #gain train.tmp 20
	execute if score #err train.tmp matches ..-1 run scoreboard players set #gain train.tmp 50
	scoreboard players operation #err train.tmp *= #gain train.tmp
	scoreboard players operation #err train.tmp /= #100 train.const
	scoreboard players operation #sp train.tmp += #err train.tmp
	execute if score #sp train.tmp matches <%u(0.45)%>.. run scoreboard players set #sp train.tmp <%u(0.45)%>
	execute if score #sp train.tmp matches ..-<%u(0.3)%> run scoreboard players set #sp train.tmp -<%u(0.3)%>

	# On a detour the chord says nothing about which way along the track to go
	execute if score #detour train.tmp matches 1 run function train:follow/detour

	# Powered rails act on the cart after the write
	execute if block ~ ~ ~ minecraft:powered_rail[powered=true] run function train:follow/boost_comp
	execute if block ~ ~ ~ minecraft:powered_rail[powered=false] run function train:follow/brake_comp

	# Motion is the unit heading times the speed
	scoreboard players operation #mx train.tmp = #dx train.tmp
	scoreboard players operation #mx train.tmp *= #sp train.tmp
	scoreboard players operation #mx train.tmp /= #len train.tmp
	scoreboard players operation #mz train.tmp = #dz train.tmp
	scoreboard players operation #mz train.tmp *= #sp train.tmp
	scoreboard players operation #mz train.tmp /= #len train.tmp

	# Within 0.3 blocks the heading means nothing and writing it would cancel vanilla's push between carts, so motion is left alone
	execute unless score #dsq train.tmp matches ..<%u(0.3) ** 2 - 1%> store result entity @s Motion[0] double <%1 / UNIT%> run scoreboard players get #mx train.tmp
	execute unless score #dsq train.tmp matches ..<%u(0.3) ** 2 - 1%> store result entity @s Motion[2] double <%1 / UNIT%> run scoreboard players get #mz train.tmp

	# Furnace followers burn fuel and push along their own PushX and PushZ, which fights the controller.
	# Only written when something is set, NBT writes every tick aren't free
	execute if entity @s[type=minecraft:furnace_minecart] unless data entity @s {Fuel:0s} run data modify entity @s Fuel set value 0s
	execute if entity @s[type=minecraft:furnace_minecart] unless data entity @s {PushX:0.0d,PushZ:0.0d} run data merge entity @s {PushX:0.0d,PushZ:0.0d}
}

# As a follower, at it, after the gap length. Sets #blocked train.tmp to 1 when another cart stands on the line to the leader, between the two
# and not at either end. In a train that only happens when the chain order is not the order on the rail, say 3 leading 1 leading 2 with the
# carts standing 1 2 3. The follower is then pulled through the cart in the middle, which backs off its own leader into the cart that
# leads everything, and that is real velocity on a head nothing controls. The two feed each other and the train never stops, see issue 9.
# Stays inside 8 blocks, the range of the leader sample
function blocked {
	scoreboard players set #blocked train.tmp 0
	scoreboard players set #end train.tmp <%u(0.5)%>
	scoreboard players operation #lim train.tmp = #len train.tmp
	scoreboard players remove #lim train.tmp <%u(0.5)%>
	execute as @e[type=#train:carts,distance=0.01..8] unless score @s train.id = #self train.tmp unless score @s train.id = #prev train.tmp run function train:follow/between
}

# As a cart that is not the follower or the leader, at the follower. Along is how far it is down the line to the leader, across how far off
# the line, both in units. A cart whose along is from half a block to half a block short of the leader, and across under 0.7, is in the way
function between {
	execute store result score #ox train.tmp run data get entity @s Pos[0] <%UNIT%>
	execute store result score #oz train.tmp run data get entity @s Pos[2] <%UNIT%>
	scoreboard players operation #ox train.tmp -= #fx train.tmp
	scoreboard players operation #oz train.tmp -= #fz train.tmp
	scoreboard players operation #along train.tmp = #ox train.tmp
	scoreboard players operation #along train.tmp *= #dx train.tmp
	scoreboard players operation #q train.tmp = #oz train.tmp
	scoreboard players operation #q train.tmp *= #dz train.tmp
	scoreboard players operation #along train.tmp += #q train.tmp
	scoreboard players operation #along train.tmp /= #len train.tmp
	scoreboard players operation #across train.tmp = #ox train.tmp
	scoreboard players operation #across train.tmp *= #dz train.tmp
	scoreboard players operation #q train.tmp = #oz train.tmp
	scoreboard players operation #q train.tmp *= #dx train.tmp
	scoreboard players operation #across train.tmp -= #q train.tmp
	scoreboard players operation #across train.tmp /= #len train.tmp
	execute if score #along train.tmp >= #end train.tmp if score #along train.tmp < #lim train.tmp if score #across train.tmp matches -<%u(0.7) - 1%>..<%u(0.7) - 1%> run scoreboard players set #blocked train.tmp 1
}


# As a follower, at it, with the leader marked from the sample
function connect {
	scoreboard players set #fresh train.tmp 1
	function train:trace/connect
	scoreboard players operation @s train.cdir = #cdir train.tmp
	scoreboard players operation @s train.cgap = #gap train.tmp
}

# As a follower. Sets #detour to 1 when the rails lead to the leader and the chord is not roughly along the way out, within 31 degrees,
# in which case rail physics could flip the cart on a bend and send it the other way. A chord along the way out, including one that backs
# off from a leader that is too close, is the normal case, and with no connection the chord is all there is, so neither is a detour
function align {
	scoreboard players set #detour train.tmp 0
	execute unless score @s train.cdir matches 1.. run return 0
	execute if score #dsq train.tmp matches ..<%u(0.3) ** 2 - 1%> run return 0
	scoreboard players set #ce train.tmp 0
	scoreboard players set #pp train.tmp 0
	execute if score @s train.cdir matches 1 run scoreboard players operation #ce train.tmp -= #dz train.tmp
	execute if score @s train.cdir matches 1 run scoreboard players operation #pp train.tmp = #dx train.tmp
	execute if score @s train.cdir matches 2 run scoreboard players operation #ce train.tmp = #dx train.tmp
	execute if score @s train.cdir matches 2 run scoreboard players operation #pp train.tmp = #dz train.tmp
	execute if score @s train.cdir matches 3 run scoreboard players operation #ce train.tmp = #dz train.tmp
	execute if score @s train.cdir matches 3 run scoreboard players operation #pp train.tmp = #dx train.tmp
	execute if score @s train.cdir matches 4 run scoreboard players operation #ce train.tmp -= #dx train.tmp
	execute if score @s train.cdir matches 4 run scoreboard players operation #pp train.tmp = #dz train.tmp
	execute if score #pp train.tmp matches ..-1 run scoreboard players operation #pp train.tmp *= #-1 train.const
	# Across times 5 against along times 3, 0.6 as a ratio
	scoreboard players set #t train.tmp 5
	scoreboard players operation #t train.tmp *= #pp train.tmp
	scoreboard players set #q train.tmp 3
	scoreboard players operation #q train.tmp *= #ce train.tmp
	scoreboard players set #detour train.tmp 1
	execute if score #ce train.tmp matches 1.. if score #t train.tmp <= #q train.tmp run scoreboard players set #detour train.tmp 0
}

# As a follower on a detour, replaces the speed and heading of the chord. Speed is the leader's, the larger axis of its velocity plus 0.4
# of the smaller, and a catch up toward the spacing along the path gap, 0.1 at most, never backward. Heading is the way the rails leave
# the follower's block toward the leader, written as a unit step so the Motion below is that direction times the speed
function detour {
	scoreboard players operation #ax train.tmp = #vx train.tmp
	execute if score #ax train.tmp matches ..-1 run scoreboard players operation #ax train.tmp *= #-1 train.const
	scoreboard players operation #az train.tmp = #vz train.tmp
	execute if score #az train.tmp matches ..-1 run scoreboard players operation #az train.tmp *= #-1 train.const
	scoreboard players operation #sp train.tmp = #ax train.tmp
	scoreboard players operation #sp train.tmp > #az train.tmp
	scoreboard players operation #t train.tmp = #ax train.tmp
	scoreboard players operation #t train.tmp < #az train.tmp
	scoreboard players operation #t train.tmp *= #2 train.const
	scoreboard players operation #t train.tmp *= #2 train.const
	scoreboard players operation #t train.tmp /= #10 train.const
	scoreboard players operation #sp train.tmp += #t train.tmp
	scoreboard players operation #err train.tmp = @s train.cgap
	scoreboard players operation #err train.tmp -= #spacing train.const
	scoreboard players operation #err train.tmp *= #20 train.const
	scoreboard players operation #err train.tmp /= #100 train.const
	execute if score #err train.tmp matches ..-1 run scoreboard players set #err train.tmp 0
	execute if score #err train.tmp matches <%u(0.1)%>.. run scoreboard players set #err train.tmp <%u(0.1)%>
	scoreboard players operation #sp train.tmp += #err train.tmp
	execute if score #sp train.tmp matches <%u(0.45)%>.. run scoreboard players set #sp train.tmp <%u(0.45)%>
	scoreboard players set #dx train.tmp 0
	scoreboard players set #dz train.tmp 0
	execute if score @s train.cdir matches 1 run scoreboard players set #dz train.tmp -1
	execute if score @s train.cdir matches 2 run scoreboard players set #dx train.tmp 1
	execute if score @s train.cdir matches 3 run scoreboard players set #dz train.tmp 1
	execute if score @s train.cdir matches 4 run scoreboard players set #dx train.tmp -1
	scoreboard players set #len train.tmp 1
	# The deadband below is for the chord, not for this
	scoreboard players set #dsq train.tmp <%u(1) ** 2%>
}


# As a follower. The chain broke, it was stretched too far for too long, or another cart is in the way. The leader is still marked from the sample
function snap {
	tag @e[tag=train.lead_now] remove train.lead_now
	function train:link/unlink
}

# As the leader cart
function leader_sample {
	scoreboard players set #found train.tmp 1
	tag @s add train.lead_now
	execute store result score #lx train.tmp run data get entity @s Pos[0] <%UNIT%>
	execute store result score #ly train.tmp run data get entity @s Pos[1] <%UNIT%>
	execute store result score #lz train.tmp run data get entity @s Pos[2] <%UNIT%>
	# Real velocity is the position change since the last sample
	scoreboard players add @s train.lpx 0
	scoreboard players add @s train.lpz 0
	scoreboard players operation #vx train.tmp = #lx train.tmp
	scoreboard players operation #vx train.tmp -= @s train.lpx
	scoreboard players operation #vz train.tmp = #lz train.tmp
	scoreboard players operation #vz train.tmp -= @s train.lpz
	scoreboard players operation @s train.lpx = #lx train.tmp
	scoreboard players operation @s train.lpz = #lz train.tmp
	# The first sample after linking has no history and teleports spike. Nothing real passes 0.45
	execute if score #vx train.tmp matches <%u(0.45)%>.. run scoreboard players set #vx train.tmp <%u(0.45)%>
	execute if score #vx train.tmp matches ..-<%u(0.45)%> run scoreboard players set #vx train.tmp -<%u(0.45)%>
	execute if score #vz train.tmp matches <%u(0.45)%>.. run scoreboard players set #vz train.tmp <%u(0.45)%>
	execute if score #vz train.tmp matches ..-<%u(0.45)%> run scoreboard players set #vz train.tmp -<%u(0.45)%>
}

# One newton step, #len = (#len + #dsq / #len) / 2
function sqrt {
	scoreboard players operation #q train.tmp = #dsq train.tmp
	scoreboard players operation #q train.tmp /= #len train.tmp
	scoreboard players operation #len train.tmp += #q train.tmp
	scoreboard players operation #len train.tmp /= #2 train.const
}

# A follower on a powered rail. The rail adds 0.06 to any moving cart after the Motion write, so ask for 0.06 less.
# Never flips the sign, a request of 0.03 becomes 0
function boost_comp {
	scoreboard players operation #o train.tmp = #sp train.tmp
	execute if score #o train.tmp matches 1.. run scoreboard players remove #sp train.tmp <%u(0.06)%>
	execute if score #o train.tmp matches 1.. if score #sp train.tmp matches ..-1 run scoreboard players set #sp train.tmp 0
	execute if score #o train.tmp matches ..-1 run scoreboard players add #sp train.tmp <%u(0.06)%>
	execute if score #o train.tmp matches ..-1 if score #sp train.tmp matches 1.. run scoreboard players set #sp train.tmp 0
}

# A follower on an unpowered powered rail. The rail halves speed, or zeroes it under 0.03, so ask for double.
# A follower keeps crawling through and the head never feels it
function brake_comp {
	scoreboard players operation #sp train.tmp += #sp train.tmp
}
