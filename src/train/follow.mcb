# Follower control. Each follower copies the speed of the cart ahead along the line to it, plus a correction toward 2 blocks of
# spacing, and gets that written as its Motion every tick. Rail physics keeps the speed and puts the direction on the track.
# The leader's speed is its real displacement since last tick. The Motion tag of a jammed cart holds whatever piled up, 3+ blocks
# per tick was seen, and copying that made carts ram each other.
# Spacing is 2 blocks because vanilla carts shove each other when hitboxes inflated by 0.2 touch, about 1.4 apart, and that fights the controller.
# The pull is toward the leader in a straight line, so on track that doubles back, a hairpin or a sharp corner, it can point against the
# follower's own track and the rail flips the cart backward. Where the follower's rails lead to the leader and the line isn't roughly
# along the way out of its block, the follower drives along the rails instead, never backward. See align and detour below. A leader on
# a parallel track is not connected by rails, the line is all there is, and the follower is pulled along it, backward if need be.

import ../../scale.js
import ../objectives.js
import ../math.mcbt

# As a follower cart, at the follower
function tick {
	scoreboard players operation #prev train.tmp = @s train.prev
	scoreboard players operation #self train.tmp = @s train.id
	scoreboard players set #found train.tmp 0
	# Position read once, every entity read serializes the whole cart
	data modify storage train:tmp pos set from entity @s Pos
	execute store result score #fx train.tmp run data get storage train:tmp pos[0] <%UNIT%>
	execute store result score #fy train.tmp run data get storage train:tmp pos[1] <%UNIT%>
	execute store result score #fz train.tmp run data get storage train:tmp pos[2] <%UNIT%>
	execute as @e[type=#train:carts,distance=..8] if score @s train.id = #prev train.tmp run function train:follow/leader_sample
	execute if score #found train.tmp matches 0 run return run function train:follow/lost
	execute if score @s train.lost matches 1.. run function train:follow/relink

	# Vector to the leader
	eq #dx train.tmp = #lx train.tmp - #fx train.tmp
	eq #dz train.tmp = #lz train.tmp - #fz train.tmp
	eq #dsq train.tmp = #dx train.tmp * #dx train.tmp + #dz train.tmp * #dz train.tmp

	# Gap length, newton from last tick's value. Never lets the estimate collapse to 0, newton can't recover from that
	scoreboard players operation #len train.tmp = @s train.len
	scoreboard players operation #old train.tmp = @s train.len
	execute if score #len train.tmp matches ..<%u(0.1) - 1%> run scoreboard players set #len train.tmp <%u(1.5)%>
	function train:follow/sqrt
	function train:follow/sqrt
	execute if score #len train.tmp matches ..<%u(0.1) - 1%> run scoreboard players set #len train.tmp <%u(0.1)%>
	scoreboard players operation @s train.len = #len train.tmp

	# Chain strain. A gap of 5 blocks or more for 5 ticks in a row breaks the chain, a single tick of it is only a blip. A gap that is
	# closing, a follower catching up on a stretch left by a slow trip through a portal, is neither a blip nor strain and leaves the count alone
	scoreboard players set #closing train.tmp 0
	scoreboard players operation #old train.tmp -= #len train.tmp
	execute if score #old train.tmp matches <%u(0.03)%>.. run scoreboard players set #closing train.tmp 1
	execute if score #len train.tmp matches <%u(5)%>.. if score #closing train.tmp matches 0 run scoreboard players add @s train.strain 1
	execute if score #len train.tmp matches <%u(5)%>.. if score #closing train.tmp matches 1 if score @s train.strain matches 1.. run scoreboard players remove @s train.strain 1
	execute unless score #len train.tmp matches <%u(5)%>.. run scoreboard players set @s train.strain 0
	execute if score @s train.strain matches 5.. run return run function train:follow/snap
	# Another cart on the line to the leader means the chain order is not the rail order, break it, see blocked
	function train:follow/blocked
	execute if score #blocked train.tmp matches 1 run return run function train:follow/snap

	# Rails to the leader. The chord is a straight line, so on a hairpin it points back along the follower's own track, and the rail
	# flips a cart whose Motion opposes it. Whether the follower's rails lead to the leader, and how far, is walked every tick. A walk every 5
	# ticks left the path length stale at a U turn, the follower backed off against the way the rails go, and the one behind it went with it.
	# A parallel track never connects, and there the chord is the only signal, reversal included
	function train:follow/connect
	# A detour is a chord that isn't along the way out of the block toward the leader
	function train:follow/align
	scoreboard players operation @s train.cdet = #detour train.tmp

	# Chain display at the midpoint, raised 0.4
	eq #cx train.tmp = (#fx train.tmp + #lx train.tmp) / 2
	eq #cy train.tmp = (#fy train.tmp + #ly train.tmp) / 2 + <%u(0.4)%>
	eq #cz train.tmp = (#fz train.tmp + #lz train.tmp) / 2
	execute as @e[type=minecraft:block_display,tag=train.chain,distance=..12] if score @s train.id = #self train.tmp run function train:chain/apply
	# Whether the leader is still within 1.5 blocks, for a wait, before its tag goes
	scoreboard players set #near train.tmp 0
	execute if score @s train.wait matches 1.. if entity @e[type=#train:carts,tag=train.lead_now,distance=..1.5] run scoreboard players set #near train.tmp 1
	tag @e[type=#train:carts,tag=train.lead_now] remove train.lead_now

	# Speed along the heading to the leader is the leader's speed on that heading plus a correction toward the spacing.
	# Gap over spacing speeds up, gap under slows or backs off, so energy never builds up down the train
	eq #sp train.tmp = (#vx train.tmp * #dx train.tmp + #vz train.tmp * #dz train.tmp) / #len train.tmp
	eq #err train.tmp = #len train.tmp - #spacing train.const
	# A follower more than a block back may run faster than a cart usually does, to close a stretch before the chain gives
	scoreboard players set #fcap train.tmp <%u(0.45)%>
	execute if score #err train.tmp matches <%u(1)%>.. run scoreboard players set #fcap train.tmp <%u(0.65)%>
	# Too close backs off 2.5x harder than too far catches up
	scoreboard players set #gain train.tmp 20
	execute if score #err train.tmp matches ..-1 run scoreboard players set #gain train.tmp 50
	scoreboard players operation #err train.tmp *= #gain train.tmp
	scoreboard players operation #err train.tmp /= #100 train.const
	scoreboard players operation #sp train.tmp += #err train.tmp
	scoreboard players operation #sp train.tmp < #fcap train.tmp
	floor #sp train.tmp -<%u(0.3)%>

	# On a detour the chord says nothing about which way along the track to go
	execute if score #detour train.tmp matches 1 run function train:follow/detour

	# Out of a portal on top of the leader, see relink. The cart stays still until the leader is clear, the chain above is drawn all the same
	execute if score @s train.wait matches 1.. run function train:follow/wait

	# Powered rails act on the cart after the write
	execute if block ~ ~ ~ minecraft:powered_rail[powered=true] run function train:follow/boost_comp
	execute if block ~ ~ ~ minecraft:powered_rail[powered=false] run function train:follow/brake_comp

	# Motion is the unit heading times the speed
	eq #mx train.tmp = #dx train.tmp * #sp train.tmp / #len train.tmp
	eq #mz train.tmp = #dz train.tmp * #sp train.tmp / #len train.tmp

	# Within 0.3 blocks the heading means nothing and writing it would cancel vanilla's push between carts, so motion is left alone.
	# What is written is remembered for a transit, see lost, and what isn't is not
	execute unless score #dsq train.tmp matches ..<%u(0.3) ** 2 - 1%> run function train:follow/write

	# Furnace followers burn fuel and push along their own PushX and PushZ, which fights the controller.
	# Only written when something is set, NBT writes every tick aren't free
	execute if entity @s[type=minecraft:furnace_minecart] unless data entity @s {Fuel:0s} run data merge entity @s {Fuel:0s,PushX:0.0d,PushZ:0.0d}
}

# As a follower, #mx #mz the Motion to write, remembered for a transit
function write {
	REPEAT (['x', 'z']) as a {
		scoreboard players operation @s train.lm<%a%> = #m<%a%> train.tmp
		execute store result entity @s Motion[<%a == 'x' ? 0 : 2%>] double <%1 / UNIT%> run scoreboard players get #m<%a%> train.tmp
	}
}

# As a follower, at it, after the gap length. Sets #blocked train.tmp to 1 when another cart stands on the line to the leader, between the two
# and not at either end. In a train that only happens when the chain order is not the order on the rail, say 3 leading 1 leading 2 with the
# carts standing 1 2 3. The follower is then pulled through the cart in the middle, which backs off its own leader into the cart that
# leads everything, and that is real velocity on a head nothing controls. The two feed each other and the train never stops, see issue 9.
# Only carts that follow this follower count. Carts of other trains and siblings on adjacent rails are not part of the loop, and the line
# between two rails can run straight over them. Stays inside 8 blocks, the range of the leader sample. Nothing fits between two carts that
# are under a block apart, so those are skipped. #len lags a few ticks after a link, so two more steps settle it for the check, and the
# tick gets its own value back at the end
function blocked {
	scoreboard players set #blocked train.tmp 0
	execute unless score #len train.tmp matches <%u(1) + 1%>.. run return 0
	scoreboard players operation #keep train.tmp = #len train.tmp
	function train:follow/sqrt
	function train:follow/sqrt
	eq #lim train.tmp = #len train.tmp - <%u(1)%>
	execute as @e[type=#train:carts,tag=train.follower,distance=0.01..8] if score @s train.prev = #self train.tmp run function train:follow/between
	scoreboard players operation #len train.tmp = #keep train.tmp
}

# As a cart that follows the follower, at the follower. Along is how far it is down the line to the leader, across how far off the line,
# both in units. A cart is in the way when its along is from a block to a block short of the leader, its across is under 0.7, and it is
# within 1.5 blocks of the follower's height. Closer than a block to either end it overlaps that cart, which carts do for a while after
# a portal, and that is a pile and not in the way. A cart above or below is on another level
function between {
	data modify storage train:tmp pos set from entity @s Pos
	execute store result score #oy train.tmp run data get storage train:tmp pos[1] <%UNIT%>
	scoreboard players operation #oy train.tmp -= #fy train.tmp
	execute unless score #oy train.tmp matches -<%u(1.5) - 1%>..<%u(1.5) - 1%> run return 0
	execute store result score #ox train.tmp run data get storage train:tmp pos[0] <%UNIT%>
	execute store result score #oz train.tmp run data get storage train:tmp pos[2] <%UNIT%>
	scoreboard players operation #ox train.tmp -= #fx train.tmp
	scoreboard players operation #oz train.tmp -= #fz train.tmp
	eq #along train.tmp = (#ox train.tmp * #dx train.tmp + #oz train.tmp * #dz train.tmp) / #len train.tmp
	eq #across train.tmp = (#ox train.tmp * #dz train.tmp - #oz train.tmp * #dx train.tmp) / #len train.tmp
	execute if score #along train.tmp >= #end train.const if score #along train.tmp < #lim train.tmp if score #across train.tmp matches -<%u(0.7) - 1%>..<%u(0.7) - 1%> run scoreboard players set #blocked train.tmp 1
}

# As a follower, at it, with the leader marked from the sample
function connect {
	function train:trace/connect
	scoreboard players operation @s train.cdir = #cdir train.tmp
	scoreboard players operation @s train.cgap = #gap train.tmp
}

# As a follower. Sets #detour to 1 when the rails lead to the leader and the chord is not roughly along the way out, within 31 degrees,
# in which case rail physics could flip the cart on a bend and send it the other way. A chord along the way out, including one that backs
# off from a leader that is too close, is the normal case, and with no connection the chord is all there is, so neither is a detour
function align {
	scoreboard players set #detour train.tmp 0
	execute unless score @s train.cdir matches 1.. run return 0
	execute if score #dsq train.tmp matches ..<%u(0.3) ** 2 - 1%> run return 0
	scoreboard players set #ce train.tmp 0
	scoreboard players set #pp train.tmp 0
	execute if score @s train.cdir matches 1 run scoreboard players operation #ce train.tmp -= #dz train.tmp
	execute if score @s train.cdir matches 1 run scoreboard players operation #pp train.tmp = #dx train.tmp
	execute if score @s train.cdir matches 2 run scoreboard players operation #ce train.tmp = #dx train.tmp
	execute if score @s train.cdir matches 2 run scoreboard players operation #pp train.tmp = #dz train.tmp
	execute if score @s train.cdir matches 3 run scoreboard players operation #ce train.tmp = #dz train.tmp
	execute if score @s train.cdir matches 3 run scoreboard players operation #pp train.tmp = #dx train.tmp
	execute if score @s train.cdir matches 4 run scoreboard players operation #ce train.tmp -= #dx train.tmp
	execute if score @s train.cdir matches 4 run scoreboard players operation #pp train.tmp = #dz train.tmp
	abs #pp train.tmp
	# Across times 5 against along times 3, 0.6 as a ratio
	scoreboard players set #t train.tmp 5
	scoreboard players operation #t train.tmp *= #pp train.tmp
	scoreboard players set #q train.tmp 3
	scoreboard players operation #q train.tmp *= #ce train.tmp
	scoreboard players set #detour train.tmp 1
	execute if score #ce train.tmp matches 1.. if score #t train.tmp <= #q train.tmp run scoreboard players set #detour train.tmp 0
	# A path much longer than the chord is a leader on the other side of a bend, a U turn put it a block away across the lane. The chord
	# calls that too close and backs the follower off, against the way the rails go
	scoreboard players operation #t train.tmp = #len train.tmp
	scoreboard players add #t train.tmp <%u(2)%>
	execute if score @s train.cgap > #t train.tmp run scoreboard players set #detour train.tmp 1
}

# As a follower on a detour, replaces the speed and heading of the chord. Speed is the leader's, the larger axis of its velocity plus 0.4
# of the smaller, and a catch up toward the spacing along the path gap, 0.1 at most, never backward. Heading is the way the rails leave
# the follower's block toward the leader, written as a unit step so the Motion below is that direction times the speed
function detour {
	abs #ax train.tmp #vx train.tmp
	abs #az train.tmp #vz train.tmp
	scoreboard players operation #sp train.tmp = #ax train.tmp
	scoreboard players operation #sp train.tmp > #az train.tmp
	scoreboard players operation #t train.tmp = #ax train.tmp
	scoreboard players operation #t train.tmp < #az train.tmp
	scoreboard players operation #t train.tmp *= #2 train.const
	scoreboard players operation #t train.tmp *= #2 train.const
	scoreboard players operation #t train.tmp /= #10 train.const
	scoreboard players operation #sp train.tmp += #t train.tmp
	scoreboard players operation #err train.tmp = @s train.cgap
	scoreboard players operation #err train.tmp -= #spacing train.const
	scoreboard players operation #err train.tmp *= #20 train.const
	scoreboard players operation #err train.tmp /= #100 train.const
	execute if score #err train.tmp matches ..-1 run scoreboard players set #err train.tmp 0
	# The catch up is 0.1 at most, 0.25 on a gap that is more than a block over
	scoreboard players set #ecap train.tmp <%u(0.1)%>
	scoreboard players operation #e2 train.tmp = @s train.cgap
	scoreboard players operation #e2 train.tmp -= #spacing train.const
	execute if score #e2 train.tmp matches <%u(1)%>.. run scoreboard players set #ecap train.tmp <%u(0.25)%>
	scoreboard players operation #err train.tmp < #ecap train.tmp
	scoreboard players operation #sp train.tmp += #err train.tmp
	scoreboard players operation #sp train.tmp < #fcap train.tmp
	scoreboard players set #dx train.tmp 0
	scoreboard players set #dz train.tmp 0
	execute if score @s train.cdir matches 1 run scoreboard players set #dz train.tmp -1
	execute if score @s train.cdir matches 2 run scoreboard players set #dx train.tmp 1
	execute if score @s train.cdir matches 3 run scoreboard players set #dz train.tmp 1
	execute if score @s train.cdir matches 4 run scoreboard players set #dx train.tmp -1
	scoreboard players set #len train.tmp 1
	# The deadband below is for the chord, not for this
	scoreboard players set #dsq train.tmp <%u(1) ** 2%>
}

# As a follower, at it, when the leader isn't within 8 blocks. A leader in this dimension that is just far, or one that is gone, frees the
# follower as it always did. A leader that exists in another dimension went through a portal ahead of the follower, which gets 60 ticks to
# follow it, #holdmax in ticks. Until then the chain stays on and rides with the follower, and on a rail the follower rolls on at the
# Motion it last wrote. Off a rail it is left alone, a write would slide it across whatever it landed on. Relinks on its own once the
# leader is in range again
function lost {
	scoreboard players set #here train.tmp 0
	scoreboard players set #any train.tmp 0
	execute as @e[type=#train:carts,distance=0..] if score @s train.id = #prev train.tmp run scoreboard players set #here train.tmp 1
	execute if score #here train.tmp matches 1 run return run function train:link/unlink
	execute as @e[type=#train:carts] if score @s train.id = #prev train.tmp run scoreboard players set #any train.tmp 1
	execute if score #any train.tmp matches 0 run return run function train:link/unlink

	scoreboard players add @s train.lost 1
	execute if score @s train.lost > #holdmax train.const run return run function train:link/unlink
	# The gap means nothing until the leader is back
	scoreboard players set @s train.strain 0
	# The rail is in the block at the cart or the one below, the top of a slope puts the cart a bit over its rail
	execute if score @s train.lost matches ..20 if block ~ ~ ~ #minecraft:rails run function train:follow/coast
	execute if score @s train.lost matches ..20 unless block ~ ~ ~ #minecraft:rails if block ~ ~-1 ~ #minecraft:rails run function train:follow/coast

	scoreboard players set #first train.tmp 0
	execute if score @s train.lost matches 1 run scoreboard players set #first train.tmp 1
	function train:chain/seen
	tag @s add train.hold_now
	execute as @e[type=minecraft:block_display,tag=train.chain] if score @s train.id = #self train.tmp run function train:chain/hold
	tag @s remove train.hold_now
}

# As a follower. Only the first 20 ticks of a hold, see lost. A follower has to cross the end of a rail at speed to touch a portal, so the
# Motion is not eased down, but a leader that left some other way than a portal doesn't leave it driving blind for the whole hold. 20 ticks
# is about 8 blocks at 0.4, a portal 2 blocks ahead is reached in a handful. An unpowered powered rail halves speed, so as in tick it is
# asked for double. A powered one is not compensated, the extra 0.06 only carries the cart further in
function coast {
	REPEAT (['x', 'z']) as a {
		scoreboard players operation #m<%a%> train.tmp = @s train.lm<%a%>
	}
	execute if block ~ ~ ~ minecraft:powered_rail[powered=false] run function train:follow/coast_brake
	REPEAT (['x', 'z']) as a {
		execute store result entity @s Motion[<%a == 'x' ? 0 : 2%>] double <%1 / UNIT%> run scoreboard players get #m<%a%> train.tmp
	}
}

function coast_brake {
	REPEAT (['x', 'z']) as a {
		scoreboard players operation #m<%a%> train.tmp += #m<%a%> train.tmp
	}
}

# As a follower with a wait running, after the chain display. Two carts out of a portal at one spot are sorted by vanilla's shove, which has no
# idea who follows who, so a follower that landed within 1.5 blocks of its leader stays still until the leader has driven clear, or 40 ticks.
# No Motion is written for the tick, the speed and the sums below it are not used
function wait {
	scoreboard players remove @s train.wait 1
	execute if score #near train.tmp matches 0 run return run scoreboard players reset @s train.wait
	data modify entity @s Motion set value [0.0d,0.0d,0.0d]
	scoreboard players set #dsq train.tmp 0
}

# As a follower that was holding, at it, with the leader in range again. The gap restarts from 2 blocks and the leader's jump into this
# dimension is not a speed. The display hops over if it was left behind, the next apply aims and stretches it
function relink {
	scoreboard players set @s train.len <%u(2)%>
	scoreboard players set @s train.strain 0
	# The rails to the leader are walked again at once, the old walk was from the other dimension
	scoreboard players reset @s train.cdir
	scoreboard players set @s train.cdet 0
	scoreboard players set #vx train.tmp 0
	scoreboard players set #vz train.tmp 0
	# The coast speed stops here. A follower that lands on its leader inside the deadband gets no Motion written, and would carry the
	# coast straight through it
	data modify entity @s Motion set value [0.0d,0.0d,0.0d]
	execute if entity @e[type=#train:carts,tag=train.lead_now,distance=..1.5] run scoreboard players set @s train.wait 40
	function train:chain/seen
	tag @s add train.hold_now
	function train:chain/hop
	tag @s remove train.hold_now
	scoreboard players reset @s train.lost
}

# As a follower. The chain broke, it was stretched too far for too long, or another cart is in the way. The leader is still marked from the sample
function snap {
	tag @e[type=#train:carts,tag=train.lead_now] remove train.lead_now
	function train:link/unlink
}

# As the leader cart
function leader_sample {
	scoreboard players set #found train.tmp 1
	tag @s add train.lead_now
	data modify storage train:tmp pos set from entity @s Pos
	execute store result score #lx train.tmp run data get storage train:tmp pos[0] <%UNIT%>
	execute store result score #ly train.tmp run data get storage train:tmp pos[1] <%UNIT%>
	execute store result score #lz train.tmp run data get storage train:tmp pos[2] <%UNIT%>
	# Once per tick: a second follower of the same leader reuses the velocity the first one took, the stored position is already this tick's
	execute if score @s train.lpt = #gen train.tmp run return run function train:follow/leader_cached
	# A leader not sampled last tick has no history, so it starts at 0 and not at the jump from wherever it was left
	scoreboard players operation #pg train.tmp = #gen train.tmp
	scoreboard players remove #pg train.tmp 1
	execute unless score @s train.lpt = #pg train.tmp run scoreboard players operation @s train.lpx = #lx train.tmp
	execute unless score @s train.lpt = #pg train.tmp run scoreboard players operation @s train.lpz = #lz train.tmp
	scoreboard players operation @s train.lpt = #gen train.tmp
	# Real velocity is the position change since the last sample
	scoreboard players operation #vx train.tmp = #lx train.tmp
	scoreboard players operation #vx train.tmp -= @s train.lpx
	scoreboard players operation #vz train.tmp = #lz train.tmp
	scoreboard players operation #vz train.tmp -= @s train.lpz
	scoreboard players operation @s train.lpx = #lx train.tmp
	scoreboard players operation @s train.lpz = #lz train.tmp
	# A teleport between two samples spikes. Nothing real passes 0.45
	clamp #vx train.tmp -<%u(0.45)%> <%u(0.45)%>
	clamp #vz train.tmp -<%u(0.45)%> <%u(0.45)%>
	scoreboard players operation @s train.lvx = #vx train.tmp
	scoreboard players operation @s train.lvz = #vz train.tmp
}

# As the leader cart, already sampled this tick
function leader_cached {
	scoreboard players operation #vx train.tmp = @s train.lvx
	scoreboard players operation #vz train.tmp = @s train.lvz
}

# One newton step, #len = (#len + #dsq / #len) / 2
function sqrt {
	scoreboard players operation #q train.tmp = #dsq train.tmp
	scoreboard players operation #q train.tmp /= #len train.tmp
	scoreboard players operation #len train.tmp += #q train.tmp
	scoreboard players operation #len train.tmp /= #2 train.const
}

# A follower on a powered rail. The rail adds 0.06 to any moving cart after the Motion write, so ask for 0.06 less.
# Never flips the sign, a request of 0.03 becomes 0
function boost_comp {
	scoreboard players operation #o train.tmp = #sp train.tmp
	execute if score #o train.tmp matches 1.. run scoreboard players remove #sp train.tmp <%u(0.06)%>
	execute if score #o train.tmp matches 1.. if score #sp train.tmp matches ..-1 run scoreboard players set #sp train.tmp 0
	execute if score #o train.tmp matches ..-1 run scoreboard players add #sp train.tmp <%u(0.06)%>
	execute if score #o train.tmp matches ..-1 if score #sp train.tmp matches 1.. run scoreboard players set #sp train.tmp 0
}

# A follower on an unpowered powered rail. The rail halves speed, or zeroes it under 0.03, so ask for double.
# A follower keeps crawling through and the head never feels it
function brake_comp {
	scoreboard players operation #sp train.tmp += #sp train.tmp
}

# Ticks in a row a follower's gap has been at the break distance, a follower's rails to its leader as exit direction plus 1, units of path and 1
# on a detour, and the last position of a leader, its tick stamp and the velocity cached for its other followers
function load minecraft:load {
	REPEAT (objectives.follow) as o {
		scoreboard objectives add train.<%o%> dummy
	}
}

# Removes this module's objectives and tags
function uninstall train:uninstall {
	tag @e[type=#train:carts] remove train.lead_now
	REPEAT (objectives.follow) as o {
		scoreboard objectives remove train.<%o%>
	}
}
