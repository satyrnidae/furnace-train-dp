# Test namespace, never part of a release. Every scenario here is run by a gametest test instance, see gametest/tests.js for the list and
# the ticks each step runs at, and gametest/run.js to run them headless, npm test. A scenario is plain functions that build a stage at the
# origin marker and spawn carts, and checks that set #ok train_test to 0 when something is wrong. The generated poll functions in the
# last region call them at the right ticks and power the accept or fail test block.

import ../../../scale.js
import ../../tests.js

function load minecraft:load {
	scoreboard objectives add train_test dummy
	# Ticks since a test started, on the marker at its command block
	scoreboard objectives add gt.age dummy
}

#region Library
# Origin marker of the arena, always at 100.5 64 100.5, everything else is placed relative to it. Clears old test entities.
# The test runner puts each test structure millions of blocks from the origin at a random spot, and a 32 bit score saturates at 33 million blocks at 64 units to a block,
# which the old scale of 1000 did at 2.1 million, so nothing here is built at the command block. It would still be fine now, the arena just stays put. The structure only carries the start,
# command, accept and fail blocks. The chunks of the arena are forceloaded by the gametest pack at load, see gametest/generate.js
function lib/begin {
	function train_test:lib/cleanup
	kill @e[tag=tt.origin]
	scoreboard players set #noavoid train.const 0
	execute positioned 100.5 64 100.5 run summon minecraft:marker ~ ~ ~ {Tags:["tt","tt.origin"]}
}

# Flat stage, floor y-1 and clear air y..y+4, x -1..46, z -4..4 from the origin
function lib/flat {
	execute at @e[tag=tt.origin,limit=1] run fill ~-1 ~-1 ~-4 ~46 ~-1 ~4 minecraft:stone
	execute at @e[tag=tt.origin,limit=1] run fill ~-1 ~ ~-4 ~46 ~4 ~4 minecraft:air
}

# Removes everything the tests spawned, items too
function lib/cleanup {
	kill @e[tag=tt,tag=!tt.origin]
	execute at @e[tag=tt.origin,limit=1] run kill @e[type=minecraft:item,distance=..64]
}

# Printed when a step fails. State of the head tt.h, if there is one, so a log is enough to see why. A headless server logs say and not tellraw.
# A score that is unset prints as -99999, x and z are whole blocks
function lib/dump {
	execute unless loaded 100 64 100 run say gt dump the arena chunk is not loaded
	execute unless entity @e[tag=tt.origin] run say gt dump there is no origin marker
	execute at @e[tag=tt.origin,limit=1] unless block ~ ~-1 ~ minecraft:stone run say gt dump no stone floor under the origin
	execute unless entity @e[tag=tt.h] run say gt dump there is no tt.h entity
	execute as @e[tag=tt.h,limit=1] run function train_test:lib/dump_one
}

function lib/dump_one {
	data merge storage train_test:dump {halt:-99999,dir:-99999,gap:-99999,svx:-99999,svz:-99999,mx:0,px:0,x:0,z:0,fuel:0}
	execute if score @s train.halt matches -2147483648..2147483647 store result storage train_test:dump halt int 1 run scoreboard players get @s train.halt
	execute if score @s train.dir matches -2147483648..2147483647 store result storage train_test:dump dir int 1 run scoreboard players get @s train.dir
	execute if score @s train.gap matches -2147483648..2147483647 store result storage train_test:dump gap int 1 run scoreboard players get @s train.gap
	execute if score @s train.svx matches -2147483648..2147483647 store result storage train_test:dump svx int 1 run scoreboard players get @s train.svx
	execute if score @s train.svz matches -2147483648..2147483647 store result storage train_test:dump svz int 1 run scoreboard players get @s train.svz
	execute store result storage train_test:dump mx int 1 run data get entity @s Motion[0] 1000
	execute store result storage train_test:dump px int 1 run data get entity @s PushX 1000
	execute store result storage train_test:dump x int 1 run data get entity @s Pos[0] 1
	execute store result storage train_test:dump z int 1 run data get entity @s Pos[2] 1
	execute store result storage train_test:dump fuel int 1 run data get entity @s Fuel
	function train_test:lib/dump_say with storage train_test:dump
	execute at @s unless block ~ ~ ~ #minecraft:rails run say gt dump the head is not standing in a rail block
	execute at @s unless block ~ ~-1 ~ minecraft:stone run say gt dump the block under the head is not stone
	execute at @s if block ~ ~ ~ minecraft:air run say gt dump the head's block is air
	execute at @s if block ~ ~-1 ~ #minecraft:rails run say gt dump a rail is one block below the head
	execute at @s if block ~ ~1 ~ #minecraft:rails run say gt dump a rail is one block above the head
	execute at @s if block ~1 ~ ~ #minecraft:rails run say gt dump a rail is east of the head
	execute at @s if block ~-1 ~ ~ #minecraft:rails run say gt dump a rail is west of the head
	execute at @s unless entity @e[tag=tt.origin,distance=..8] run say gt dump the origin marker is far from the head
}

function lib/dump_say {
	$say gt dump halt=$(halt) dir=$(dir) gap=$(gap) svx=$(svx) svz=$(svz) motion_x=$(mx) push_x=$(px) x=$(x) z=$(z) fuel=$(fuel)
}

# Macro, name from storage train_test:cur. Says PASS or FAIL, say is what reaches a headless server log, tellraw has no player to send to
function lib/report {
	$execute if score #ok train_test matches 1 run say gt PASS $(name)
	$execute unless score #ok train_test matches 1 run say gt FAIL $(name)
}
#endregion

#region Task 5 crash
# Snapshot of the stage blocks 20 blocks south, to prove an explosion changed none
function lib/ref {
	execute at @e[tag=tt.origin,limit=1] run clone ~-1 ~-1 ~-4 ~46 ~4 ~4 ~-1 ~-1 ~16
}

# Sets #ok train_test to 0 unless the stage still equals the snapshot
function lib/ref_check {
	execute at @e[tag=tt.origin,limit=1] unless blocks ~-1 ~-1 ~-4 ~46 ~4 ~4 ~-1 ~-1 ~16 all run scoreboard players set #ok train_test 0
}

# t10 a real head-on, braking off. Two fueled furnaces meet in the middle
function t10/start {
	function train_test:lib/begin
	scoreboard players set #noavoid train.const 1
	function train_test:lib/flat
	function train_test:lib/strip
	function train_test:lib/ref
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~5 ~ ~ {Tags:["tt","tt.a"],Fuel:3000s,PushX:1.0d,PushZ:0.0d}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~25 ~ ~ {Tags:["tt","tt.b"],Fuel:3000s,PushX:-1.0d,PushZ:0.0d}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:pig ~15 ~ ~2 {Tags:["tt","tt.near"],NoAI:1b}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:pig ~15 ~ ~-3.9 {Tags:["tt","tt.far"],NoAI:1b}
}
function t10/check {
	scoreboard players set #ok train_test 1
	execute if entity @e[type=minecraft:furnace_minecart,tag=tt] run scoreboard players set #ok train_test 0
	execute store result score #n train_test at @e[tag=tt.origin,limit=1] if entity @e[type=minecraft:item,nbt={Item:{id:"minecraft:furnace_minecart"}},distance=..64]
	execute unless score #n train_test matches 2 run scoreboard players set #ok train_test 0
	execute if entity @e[tag=tt.near,nbt={Health:10.0f}] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.near] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.far,nbt={Health:10.0f}] run scoreboard players set #ok train_test 0
	function train_test:lib/ref_check
}

# t11 a touch below 0.1 blocks per tick just bumps
function t11/start {
	function train_test:lib/begin
	scoreboard players set #noavoid train.const 1
	function train_test:lib/flat
	function train_test:lib/strip
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~10 ~ ~ {Tags:["tt","tt.a"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~12 ~ ~ {Tags:["tt","tt.b"],Motion:[-0.05d,0d,0d]}
}
function t11/check {
	scoreboard players set #ok train_test 1
	execute unless entity @e[tag=tt.a] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.b] run scoreboard players set #ok train_test 0
	# They have to have touched. b starts 2.0 away and creeps 1.25 at the most, so within 1.6 means it got there. With braking on b stops
	# short and this test used to pass without any contact
	execute store result score #ax train_test run data get entity @e[tag=tt.a,limit=1] Pos[0] <%UNIT%>
	execute store result score #bx train_test run data get entity @e[tag=tt.b,limit=1] Pos[0] <%UNIT%>
	scoreboard players operation #dd train_test = #bx train_test
	scoreboard players operation #dd train_test -= #ax train_test
	execute if score #dd train_test matches ..-1 run scoreboard players operation #dd train_test *= #-1 train.const
	execute unless score #dd train_test matches ..<%u(1.6)%> run scoreboard players set #ok train_test 0
}

# t12 two furnaces of one train in a hard closing contact do not explode. Velocities are set by hand so only the train rule is under test
function t12/start {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~10 ~ ~ {Tags:["tt","tt.a"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~11 ~ ~ {Tags:["tt","tt.b"]}
	execute as @e[tag=tt.a,limit=1] run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.a,limit=1] train.id
	execute as @e[tag=tt.b,limit=1] run function train:link/apply
	function train_test:lib/hard_closing
	function train:crash/tick
	scoreboard players set #ok train_test 1
	execute unless entity @e[tag=tt.a] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.b] run scoreboard players set #ok train_test 0
}

# Positions into the sampler scores and a closing speed of 0.6 between tt.a and tt.b, a moving right and b moving left
function lib/hard_closing {
	execute store result score @e[tag=tt.a,limit=1] train.ppx run data get entity @e[tag=tt.a,limit=1] Pos[0] <%UNIT%>
	execute store result score @e[tag=tt.a,limit=1] train.ppz run data get entity @e[tag=tt.a,limit=1] Pos[2] <%UNIT%>
	execute store result score @e[tag=tt.b,limit=1] train.ppx run data get entity @e[tag=tt.b,limit=1] Pos[0] <%UNIT%>
	execute store result score @e[tag=tt.b,limit=1] train.ppz run data get entity @e[tag=tt.b,limit=1] Pos[2] <%UNIT%>
	scoreboard players set @e[tag=tt.a,limit=1] train.svx <%u(0.3)%>
	scoreboard players set @e[tag=tt.a,limit=1] train.svz 0
	scoreboard players set @e[tag=tt.b,limit=1] train.svx -<%u(0.3)%>
	scoreboard players set @e[tag=tt.b,limit=1] train.svz 0
}

# t13 two furnaces that spawn 0.9 blocks apart are not a hit, a new cart has no velocity yet
function t13/start {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~10 ~ ~ {Tags:["tt","tt.a"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~10.9 ~ ~ {Tags:["tt","tt.b"]}
}
function t13/check {
	scoreboard players set #ok train_test 1
	execute unless entity @e[tag=tt.a] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.b] run scoreboard players set #ok train_test 0
}

# t14 different trains in a hard closing contact explode, and a coupled cart standing 2 blocks from the impact is untouched
function t14/start {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~10 ~ ~ {Tags:["tt","tt.a"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~11 ~ ~ {Tags:["tt","tt.b"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~12 ~ ~ {Tags:["tt","tt.f"]}
	execute as @e[tag=tt.b,limit=1] run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.b,limit=1] train.id
	execute as @e[tag=tt.f,limit=1] run function train:link/apply
	function train_test:lib/hard_closing
	function train:crash/tick
	scoreboard players set #ok train_test 1
	execute if entity @e[type=minecraft:furnace_minecart,tag=tt] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.f] run scoreboard players set #ok train_test 0
	execute store result score #n train_test at @e[tag=tt.origin,limit=1] if entity @e[type=minecraft:item,nbt={Item:{id:"minecraft:furnace_minecart"}},distance=..64]
	execute unless score #n train_test matches 2 run scoreboard players set #ok train_test 0
}
#endregion

#region Task 4 avoid
# 45 east-west rails from the origin
function lib/strip {
	execute at @e[tag=tt.origin,limit=1] run fill ~ ~ ~ ~44 ~ ~ minecraft:rail[shape=east_west]
}

# Fueled head, pushing east, on the strip at x 3
function lib/head {
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~3 ~ ~ {Tags:["tt","tt.h"],Fuel:3000s,PushX:1.0d,PushZ:0.0d}
}

# Asserts for a head tt.h that should be yielding in front of a parked cart tt.x: still alive, halt 3, speed under 0.01, at least 2.0
# blocks of path between them, nothing blown up. Distance is manhattan so it also holds on a curve
function lib/stopped_short {
	scoreboard players set #ok train_test 1
	execute unless entity @e[tag=tt.h] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.h,scores={train.halt=3,train.svx=-<%u(0.02)%>..<%u(0.02)%>,train.svz=-<%u(0.02)%>..<%u(0.02)%>}] run scoreboard players set #ok train_test 0
	execute store result score #hx train_test run data get entity @e[tag=tt.h,limit=1] Pos[0] <%UNIT%>
	execute store result score #hz train_test run data get entity @e[tag=tt.h,limit=1] Pos[2] <%UNIT%>
	execute store result score #px train_test run data get entity @e[tag=tt.x,limit=1] Pos[0] <%UNIT%>
	execute store result score #pz train_test run data get entity @e[tag=tt.x,limit=1] Pos[2] <%UNIT%>
	scoreboard players operation #dx train_test = #px train_test
	scoreboard players operation #dx train_test -= #hx train_test
	execute if score #dx train_test matches ..-1 run scoreboard players operation #dx train_test *= #-1 train.const
	scoreboard players operation #dz train_test = #pz train_test
	scoreboard players operation #dz train_test -= #hz train_test
	execute if score #dz train_test matches ..-1 run scoreboard players operation #dz train_test *= #-1 train.const
	scoreboard players operation #dx train_test += #dz train_test
	execute unless score #dx train_test matches <%u(2)%>.. run scoreboard players set #ok train_test 0
	execute at @e[tag=tt.origin,limit=1] if entity @e[type=minecraft:item,distance=..64] run scoreboard players set #ok train_test 0
}

# t2 a head stops short of a lone parked cart
function t2/start {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	function train_test:lib/head
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~30 ~ ~ {Tags:["tt","tt.x"]}
}
function t2/check {
	function train_test:lib/stopped_short
}

# t3 same in front of a parked coupled train, the station case. The three carts are coupled through the real link code
function t3/start {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	function train_test:lib/head
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~30 ~ ~ {Tags:["tt","tt.x"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~32 ~ ~ {Tags:["tt","tt.y"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~34 ~ ~ {Tags:["tt","tt.z"]}
	execute as @e[tag=tt.x,limit=1] run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.x,limit=1] train.id
	execute as @e[tag=tt.y,limit=1] run function train:link/apply
	execute as @e[tag=tt.y,limit=1] run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.y,limit=1] train.id
	execute as @e[tag=tt.z,limit=1] run function train:link/apply
}
function t3/check {
	function train_test:lib/stopped_short
}

# t4 the cart in front leaves, the head leaves state 3 and gets its speed back
function t4/start {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	function train_test:lib/head
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~30 ~ ~ {Tags:["tt","tt.x"]}
}
function t4/peek {
	function train_test:lib/dump
}
function t4/pop {
	kill @e[tag=tt.x]
}
function t4/check {
	scoreboard players set #ok train_test 1
	execute unless entity @e[tag=tt.h,scores={train.halt=0,train.svx=<%u(0.1)%>..}] run scoreboard players set #ok train_test 0
}

# t5 two heads with ids 7 apart trace on different ticks
function t5/start {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~ ~ ~-2 {Tags:["tt","tt.a"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~ ~ ~2 {Tags:["tt","tt.b"]}
	scoreboard players set @e[tag=tt.a,limit=1] train.id 100
	scoreboard players set @e[tag=tt.b,limit=1] train.id 107
	scoreboard players set @e[tag=tt.a] train.dir 1
	scoreboard players set @e[tag=tt.b] train.dir 1
}
function t5/check {
	scoreboard players set #ok train_test 1
	execute unless entity @e[tag=tt.a,scores={train.chk=1..}] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.b,scores={train.chk=1..}] run scoreboard players set #ok train_test 0
	scoreboard players operation #a train_test = @e[tag=tt.a,limit=1] train.chk
	scoreboard players operation #a train_test %= #period train.const
	scoreboard players operation #b train_test = @e[tag=tt.b,limit=1] train.chk
	scoreboard players operation #b train_test %= #period train.const
	execute if score #a train_test = #b train_test run scoreboard players set #ok train_test 0
}

# t6 a head with no heading yet does not trace and does not yield, even with a cart 2 blocks ahead
function t6/start {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~3 ~ ~ {Tags:["tt","tt.h"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~5 ~ ~ {Tags:["tt","tt.x"]}
}
function t6/check {
	scoreboard players set #ok train_test 1
	execute if entity @e[tag=tt.h,scores={train.halt=3}] run scoreboard players set #ok train_test 0
	execute if score @e[tag=tt.h,limit=1] train.gap matches -2147483648..2147483647 run scoreboard players set #ok train_test 0
}

# t7 a foreign cart in the head's own block is gap 0, the head holds, no division by zero. One tick, no movement
function t7/start {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~3 ~ ~ {Tags:["tt","tt.h"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~3 ~ ~ {Tags:["tt","tt.x"]}
	scoreboard players set @e[tag=tt.h,limit=1] train.dir 1
	execute as @e[tag=tt.h,limit=1] run function train:avoid/trace
	execute as @e[tag=tt.h,limit=1] run function train:avoid/head
	scoreboard players set #ok train_test 1
	execute unless entity @e[tag=tt.h,scores={train.halt=3,train.gap=0}] run scoreboard players set #ok train_test 0
}

# t8 the same stop on a curve. East along 11 rails, a curve south, then south, the parked cart at the end
function t8/start {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run fill ~ ~ ~ ~10 ~ ~ minecraft:rail[shape=east_west]
	execute at @e[tag=tt.origin,limit=1] run setblock ~11 ~ ~ minecraft:rail[shape=south_west]
	execute at @e[tag=tt.origin,limit=1] run fill ~11 ~ ~1 ~11 ~ ~3 minecraft:rail[shape=north_south]
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~1 ~ ~ {Tags:["tt","tt.h"],Fuel:3000s,PushX:1.0d,PushZ:0.0d}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~11 ~ ~3 {Tags:["tt","tt.x"]}
}
function t8/check {
	function train_test:lib/stopped_short
}

# t9 the same stop up a slope, the parked cart on the rails one level up
function t9/start {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run fill ~ ~ ~ ~9 ~ ~ minecraft:rail[shape=east_west]
	execute at @e[tag=tt.origin,limit=1] run setblock ~10 ~ ~ minecraft:rail[shape=ascending_east]
	execute at @e[tag=tt.origin,limit=1] run fill ~11 ~ ~ ~22 ~ ~ minecraft:stone
	execute at @e[tag=tt.origin,limit=1] run fill ~11 ~1 ~ ~22 ~1 ~ minecraft:rail[shape=east_west]
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~1 ~ ~ {Tags:["tt","tt.h"],Fuel:3000s,PushX:1.0d,PushZ:0.0d}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~22 ~1 ~ {Tags:["tt","tt.x"]}
}
function t9/check {
	function train_test:lib/stopped_short
}
#endregion

#region Task 3 tracer
# Expected exits for every valid shape and heading pair, written out by hand from the rail edges and not derived from the tracer's own table.
# Fields: shape, heading, exit heading, 1 when the exit is the high edge of a slope. Each case puts a foreign cart one block beyond, so the gap is one block.
<%%
const HEAD = { n: 0, e: 1, s: 2, w: 3 };
const STEP = { n: [0, 0, -1], e: [1, 0, 0], s: [0, 0, 1], w: [-1, 0, 0] };
const PAIRS = [
	["north_south", "n", "n", 0], ["north_south", "s", "s", 0],
	["east_west", "e", "e", 0], ["east_west", "w", "w", 0],
	["ascending_east", "e", "e", 1], ["ascending_east", "w", "w", 0],
	["ascending_west", "w", "w", 1], ["ascending_west", "e", "e", 0],
	["ascending_north", "n", "n", 1], ["ascending_north", "s", "s", 0],
	["ascending_south", "s", "s", 1], ["ascending_south", "n", "n", 0],
	["south_east", "n", "e", 0], ["south_east", "w", "s", 0],
	["south_west", "n", "w", 0], ["south_west", "e", "s", 0],
	["north_west", "s", "w", 0], ["north_west", "e", "n", 0],
	["north_east", "s", "e", 0], ["north_east", "w", "n", 0],
];
for (const [shape, h, exit, up] of PAIRS) {
	const [dx, , dz] = STEP[exit];
	const dy = up ? 1 : 0;
	const nshape = exit === "e" || exit === "w" ? "east_west" : "north_south";
	const lines = [];
	// A rail takes its shape from its neighbors when it is placed, so a lone curve comes out straight. Curves get a rail on the entry edge as
	// well, both neighbors are placed first, and the curve last
	const curve = ["south_east", "south_west", "north_west", "north_east"].includes(shape);
	const [ex, , ez] = STEP[{ n: "s", e: "w", s: "n", w: "e" }[h]];
	const entry = `~${ex} ~ ~${ez}`;
	if (up) lines.push(`\tsetblock ~${dx} ~ ~${dz} minecraft:stone`);
	if (curve) lines.push(`\tsetblock ${entry} minecraft:rail[shape=${h === "e" || h === "w" ? "east_west" : "north_south"}]`);
	if (curve) lines.push(`\tsetblock ~${dx} ~${dy} ~${dz} minecraft:rail[shape=${nshape}]`);
	lines.push(`\tsetblock ~ ~ ~ minecraft:rail[shape=${shape}]`);
	if (!curve) lines.push(`\tsetblock ~${dx} ~${dy} ~${dz} minecraft:rail[shape=${nshape}]`);
	lines.push(`\tsummon minecraft:furnace_minecart ~ ~ ~ {Tags:["tt","tt.h"]}`);
	lines.push(`\tsummon minecraft:minecart ~${dx} ~${dy} ~${dz} {Tags:["tt","tt.x"]}`);
	lines.push(`\tscoreboard players set @e[tag=tt.h,limit=1] train.dir ${HEAD[h]}`);
	lines.push(`\texecute as @e[tag=tt.h,limit=1] run function train:trace/run`);
	lines.push(`\texecute unless score #gap train.tmp matches ${UNIT} run scoreboard players set #ok train_test 0`);
	lines.push(`\texecute unless score #gap train.tmp matches ${UNIT} run say gt shape FAIL ${shape} heading ${h}`);
	lines.push(`\texecute if entity @e[tag=train.mine] run scoreboard players set #ok train_test 0`);
	lines.push(`\tkill @e[tag=tt.h]`);
	lines.push(`\tkill @e[tag=tt.x]`);
	lines.push(`\tkill @e[type=minecraft:item,distance=..4]`);
	lines.push(`\tsetblock ~ ~ ~ minecraft:air`);
	lines.push(`\tsetblock ~${dx} ~${dy} ~${dz} minecraft:air`);
	if (curve) lines.push(`\tsetblock ${entry} minecraft:air`);
	if (up) lines.push(`\tsetblock ~${dx} ~ ~${dz} minecraft:stone`);
	emit.mcb(`function trace/shape_${shape}_${h} {\n${lines.join("\n")}\n}`);
}
const calls = PAIRS.map(([shape, h]) => `\texecute at @e[tag=tt.origin,limit=1] run function train_test:trace/shape_${shape}_${h}`);
emit.mcb(`function trace/shapes {\n\tscoreboard players set #ok train_test 1\n${calls.join("\n")}\n}`);
%%>

# Shared by the layout cases. As the player, runs the trace from the head and adds a failure when the answer is wrong or a tag leaked
# Needs #want train_test, the expected gap
function trace/shoot {
	scoreboard players set #gap train.tmp -1
	execute as @e[tag=tt.h,limit=1] run function train:trace/run
	execute unless score #gap train.tmp = #want train_test run scoreboard players set #ok train_test 0
	execute if entity @e[tag=train.mine] run scoreboard players set #ok train_test 0
}

# Heading east on flat rails, a curve south, then straight south, the cart is 9 blocks along the path
function trace/curve {
	execute at @e[tag=tt.origin,limit=1] run {
		fill ~ ~ ~ ~4 ~ ~ minecraft:rail[shape=east_west]
		setblock ~5 ~ ~ minecraft:rail[shape=south_west]
		fill ~5 ~ ~1 ~5 ~ ~4 minecraft:rail[shape=north_south]
		summon minecraft:furnace_minecart ~ ~ ~ {Tags:["tt","tt.h"]}
		summon minecraft:minecart ~5 ~ ~4 {Tags:["tt","tt.x"]}
	}
	scoreboard players set @e[tag=tt.h,limit=1] train.dir 1
	scoreboard players set #want train_test <%9 * UNIT%>
	function train_test:trace/shoot
}

# Up a slope onto rails one higher, the cart is 7 blocks along
function trace/up {
	execute at @e[tag=tt.origin,limit=1] run {
		fill ~ ~ ~ ~2 ~ ~ minecraft:rail[shape=east_west]
		setblock ~3 ~ ~ minecraft:rail[shape=ascending_east]
		fill ~4 ~ ~ ~7 ~ ~ minecraft:stone
		fill ~4 ~1 ~ ~7 ~1 ~ minecraft:rail[shape=east_west]
		summon minecraft:furnace_minecart ~ ~ ~ {Tags:["tt","tt.h"]}
		summon minecraft:minecart ~7 ~1 ~ {Tags:["tt","tt.x"]}
	}
	scoreboard players set @e[tag=tt.h,limit=1] train.dir 1
	scoreboard players set #want train_test <%7 * UNIT%>
	function train_test:trace/shoot
}

# Down two slopes, the second one a block lower, then flat, the cart is 6 blocks along
function trace/down {
	execute at @e[tag=tt.origin,limit=1] run {
		fill ~ ~ ~ ~1 ~ ~ minecraft:rail[shape=east_west]
		setblock ~2 ~ ~ minecraft:rail[shape=ascending_west]
		fill ~3 ~-1 ~ ~6 ~-1 ~ minecraft:air
		fill ~3 ~-2 ~ ~6 ~-2 ~ minecraft:stone
		setblock ~3 ~-1 ~ minecraft:rail[shape=ascending_west]
		fill ~4 ~-1 ~ ~6 ~-1 ~ minecraft:rail[shape=east_west]
		summon minecraft:furnace_minecart ~ ~ ~ {Tags:["tt","tt.h"]}
		summon minecraft:minecart ~6 ~-1 ~ {Tags:["tt","tt.x"]}
	}
	scoreboard players set @e[tag=tt.h,limit=1] train.dir 1
	scoreboard players set #want train_test <%6 * UNIT%>
	function train_test:trace/shoot
}

# 17 rails and nothing on them is clear
function trace/clear {
	execute at @e[tag=tt.origin,limit=1] run {
		fill ~ ~ ~ ~16 ~ ~ minecraft:rail[shape=east_west]
		summon minecraft:furnace_minecart ~ ~ ~ {Tags:["tt","tt.h"]}
	}
	scoreboard players set @e[tag=tt.h,limit=1] train.dir 1
	scoreboard players set #want train_test <%u(99)%>
	function train_test:trace/shoot
}

# A block that is not a rail ends the trace clear, whatever lies beyond it
function trace/modded {
	execute at @e[tag=tt.origin,limit=1] run {
		fill ~ ~ ~ ~2 ~ ~ minecraft:rail[shape=east_west]
		setblock ~3 ~ ~ minecraft:stone
		fill ~4 ~ ~ ~6 ~ ~ minecraft:rail[shape=east_west]
		summon minecraft:furnace_minecart ~ ~ ~ {Tags:["tt","tt.h"]}
		summon minecraft:minecart ~5 ~ ~ {Tags:["tt","tt.x"]}
	}
	scoreboard players set @e[tag=tt.h,limit=1] train.dir 1
	scoreboard players set #want train_test <%u(99)%>
	function train_test:trace/shoot
}

# A cart of the head's own train is not an obstacle, only the foreign one behind it counts
function trace/own_train {
	execute at @e[tag=tt.origin,limit=1] run {
		fill ~ ~ ~ ~8 ~ ~ minecraft:rail[shape=east_west]
		summon minecraft:furnace_minecart ~ ~ ~ {Tags:["tt","tt.h"]}
		summon minecraft:minecart ~2 ~ ~ {Tags:["tt","tt.f"]}
		summon minecraft:minecart ~6 ~ ~ {Tags:["tt","tt.x"]}
	}
	scoreboard players set @e[tag=tt.h,limit=1] train.dir 1
	execute as @e[tag=tt.h,limit=1] unless score @s train.id = @s train.id run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.h,limit=1] train.id
	execute as @e[tag=tt.f,limit=1] run function train:link/apply
	scoreboard players set #want train_test <%6 * UNIT%>
	function train_test:trace/shoot
}

function trace/each_curve {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:trace/curve
}
function trace/each_up {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:trace/up
}
function trace/each_down {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:trace/down
}
function trace/each_clear {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:trace/clear
}
function trace/each_modded {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:trace/modded
}
function trace/each_own_train {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:trace/own_train
}
function trace/each_shapes {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:trace/shapes
}
#endregion

#region Trace from inside a curve
# The head is inside a curve block, already heading toward the exit edge. A curve has no entry edge for that heading, the cart came in on the
# other one, so the first block of a trace also has to accept a heading toward any of its edges. South out of a south_west curve, then 3 rails
# of straight south with the cart on the last, 3 blocks along
function trace/midcurve {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run {
		setblock ~-1 ~ ~ minecraft:rail[shape=east_west]
		fill ~ ~ ~1 ~ ~ ~3 minecraft:rail[shape=north_south]
		setblock ~ ~ ~ minecraft:rail[shape=south_west]
		summon minecraft:furnace_minecart ~ ~ ~ {Tags:["tt","tt.h"]}
		summon minecraft:minecart ~ ~ ~3 {Tags:["tt","tt.x"]}
	}
	scoreboard players set @e[tag=tt.h,limit=1] train.dir 2
	scoreboard players set #want train_test <%3 * UNIT%>
	function train_test:trace/shoot
}
#endregion

#region Followers on the move
# A fueled head pulls two coupled followers along the strip. After 100 ticks it has gone a good way and each follower holds about 2 blocks
# behind the cart ahead, the spacing of follow.mcb, within 0.35 either side
function t20/start {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	function train_test:lib/head
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~1 ~ ~ {Tags:["tt","tt.f"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~-1 ~ ~ {Tags:["tt","tt.g"]}
	execute as @e[tag=tt.h,limit=1] run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.h,limit=1] train.id
	execute as @e[tag=tt.f,limit=1] run function train:link/apply
	execute as @e[tag=tt.f,limit=1] run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.f,limit=1] train.id
	execute as @e[tag=tt.g,limit=1] run function train:link/apply
}
function t20/check {
	execute store result score #hx train_test run data get entity @e[tag=tt.h,limit=1] Pos[0] <%UNIT%>
	execute store result score #fx train_test run data get entity @e[tag=tt.f,limit=1] Pos[0] <%UNIT%>
	execute store result score #gx train_test run data get entity @e[tag=tt.g,limit=1] Pos[0] <%UNIT%>
	scoreboard players operation #d1 train_test = #hx train_test
	scoreboard players operation #d1 train_test -= #fx train_test
	scoreboard players operation #d2 train_test = #fx train_test
	scoreboard players operation #d2 train_test -= #gx train_test
	execute unless score #d1 train_test matches <%u(1.65)%>..<%u(2.35)%> run scoreboard players set #ok train_test 0
	execute unless score #d2 train_test matches <%u(1.65)%>..<%u(2.35)%> run scoreboard players set #ok train_test 0
	# It went somewhere, the head started at x 3 of the origin and the strip is 45 long
	execute at @e[tag=tt.origin,limit=1] unless entity @e[tag=tt.h,distance=8..] run scoreboard players set #ok train_test 0
}
#endregion

#region Far from the origin
# The same stop as t2 at x 25 million, past where the old scale of 1000 saturated, and inside the world border where 64 units to a block still fits. The arena is
# forceloaded first and given time to load, then built with the origin moved out there. Everything else is relative to the origin marker
function far/prep {
	forceload add 24999990 90 25000060 130
}
function far/start {
	function train_test:lib/cleanup
	kill @e[tag=tt.origin]
	scoreboard players set #noavoid train.const 0
	execute unless loaded 25000000 64 100 run scoreboard players set #ok train_test 0
	execute positioned 25000000.5 64 100.5 run summon minecraft:marker ~ ~ ~ {Tags:["tt","tt.origin"]}
	function train_test:lib/flat
	function train_test:lib/strip
	function train_test:lib/head
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~30 ~ ~ {Tags:["tt","tt.x"]}
}
function far/check {
	function train_test:lib/stopped_short
}
#endregion

#region Parallel tracks
# Two furnaces on rails one block apart, closing hard, are inside 1.15 of each other and never touch, a cart is 0.98 wide. Velocities by hand.
# Only the offset along the line of the closing speed has to be small for a hit, the sideways one has to be under 0.6
function t17/run {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~10 ~ ~ {Tags:["tt","tt.a"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~10.3 ~ ~1 {Tags:["tt","tt.b"]}
	function train_test:lib/hard_closing
	function train:crash/tick
	execute unless entity @e[tag=tt.a] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.b] run scoreboard players set #ok train_test 0
}
#endregion

#region Reverse out of a yield
# A head holding short of a cart ahead, and the player fuels it from the other side, which sets a push against its heading. It has to turn
# around and go, a heading that never updates because the head never moves would hold it there until the cart leaves
function t18/start {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	function train_test:lib/head
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~10 ~ ~ {Tags:["tt","tt.x"]}
}
function t18/reverse {
	data merge entity @e[tag=tt.h,limit=1] {PushX:-1.0d,PushZ:0.0d,Fuel:3000s}
}
function t18/check {
	execute unless entity @e[tag=tt.h,scores={train.halt=0,train.svx=..-<%u(0.1)%>}] run scoreboard players set #ok train_test 0
}
#endregion

#region Trace from the crest of a slope
# A cart at the top of a slope block has feet a hair above the block, so the block at its feet is air and the rail is the one below. The trace
# used to read that as no rail and clear. The head hangs at the crest of an ascending_east, the cart is on the rails one level up, 1 block along
function trace/crest {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run {
		setblock ~-1 ~ ~ minecraft:rail[shape=east_west]
		setblock ~1 ~ ~ minecraft:stone
		setblock ~1 ~1 ~ minecraft:rail[shape=east_west]
		setblock ~ ~ ~ minecraft:rail[shape=ascending_east]
		summon minecraft:furnace_minecart ~ ~1.0625 ~ {Tags:["tt","tt.h"],NoGravity:1b}
		summon minecraft:minecart ~1 ~1 ~ {Tags:["tt","tt.x"]}
	}
	scoreboard players set @e[tag=tt.h,limit=1] train.dir 1
	scoreboard players set #want train_test <%1 * UNIT%>
	function train_test:trace/shoot
}
#endregion

#region Cold start
# A head that starts from rest has no heading until it moves, and used to take its first trace up to a full period later, about 4 blocks of
# travel at 0.2. The cart is 5 blocks ahead, so it has to be seen before the head gets there
function t16/start {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	function train_test:lib/head
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~8 ~ ~ {Tags:["tt","tt.x"]}
}
function t16/check {
	function train_test:lib/stopped_short
}
#endregion

#region Heading on a curve
# On a curve block a cart moves diagonally and |vx| and |vz| differ by rounding noise, so a tie break would flip the heading between the entry axis
# and the exit axis. Heading is only updated when one axis clearly dominates. The sampler is driven by hand, sample/cart a first time to
# set the previous position, then a move, then sample/cart again, all in one tick
function t15/run {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~3 ~ ~ {Tags:["tt","tt.h"]}
	scoreboard players set @e[tag=tt.h,limit=1] train.dir 1
	execute as @e[tag=tt.h,limit=1] at @s run function train:sample/cart
	# Diagonal, 0.2 east and 0.21 south, z is ahead by 5 percent, not a change of heading
	execute as @e[tag=tt.h,limit=1] at @s run tp @s ~0.2 ~ ~0.21
	execute as @e[tag=tt.h,limit=1] at @s run function train:sample/cart
	execute unless entity @e[tag=tt.h,scores={train.dir=1}] run scoreboard players set #ok train_test 0
	# Diagonal the other way, 0.2 east and 0.19 north, still east
	execute as @e[tag=tt.h,limit=1] at @s run tp @s ~0.2 ~ ~-0.19
	execute as @e[tag=tt.h,limit=1] at @s run function train:sample/cart
	execute unless entity @e[tag=tt.h,scores={train.dir=1}] run scoreboard players set #ok train_test 0
	# A clear move north does change it
	execute as @e[tag=tt.h,limit=1] at @s run tp @s ~ ~ ~-0.2
	execute as @e[tag=tt.h,limit=1] at @s run function train:sample/cart
	execute unless entity @e[tag=tt.h,scores={train.dir=0}] run scoreboard players set #ok train_test 0
}
#endregion

#region Task 2 sampler
# Furnace a moves, b and c stand. Steps run from a command block, which ticks after train:tick, so a step at age N sees the sampler's
# result for tick N.
function t1/start {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run fill ~2 ~ ~ ~42 ~ ~ minecraft:rail[shape=east_west]
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~5 ~ ~ {Tags:["tt","tt.a"],Motion:[0.2d,0d,0d]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~20 ~ ~ {Tags:["tt","tt.b"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~30 ~ ~ {Tags:["tt","tt.c"]}
}

# A moving furnace has a velocity and a heading east, a parked one has neither
function t1/check {
	scoreboard players set #ok train_test 1
	scoreboard players set #v train_test -9999
	execute store result score #v train_test run scoreboard players get @e[tag=tt.a,limit=1] train.svx
	execute unless score #v train_test matches <%u(0.1)%>..<%u(0.25)%> run scoreboard players set #ok train_test 0
	scoreboard players set #v train_test -9999
	execute store result score #v train_test run scoreboard players get @e[tag=tt.a,limit=1] train.dir
	execute unless score #v train_test matches 1 run scoreboard players set #ok train_test 0
	scoreboard players set #v train_test -9999
	execute store result score #v train_test run scoreboard players get @e[tag=tt.b,limit=1] train.svx
	execute unless score #v train_test matches -<%u(0.02)%>..<%u(0.02)%> run scoreboard players set #ok train_test 0
	execute if score @e[tag=tt.b,limit=1] train.dir matches -100..100 run scoreboard players set #ok train_test 0
}

function t1/tp {
	execute as @e[tag=tt.c] at @s run tp @s ~15 ~ ~
}

# A teleport is not a speed, the tick after it the velocity is 0, never the speed clamp
function t1/check_tp {
	scoreboard players set #ok train_test 1
	scoreboard players set #v train_test -9999
	execute store result score #v train_test run scoreboard players get @e[tag=tt.c,limit=1] train.svx
	execute unless score #v train_test matches 0 run scoreboard players set #ok train_test 0
}

# root_of on a follower is its head, on a lone cart a new id of its own
function t1/roots {
	scoreboard players set #ok train_test 1
	execute as @e[tag=tt.a,limit=1] unless score @s train.id = @s train.id run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.a,limit=1] train.id
	execute as @e[tag=tt.b,limit=1] run function train:link/apply
	scoreboard players operation #aid train_test = @e[tag=tt.a,limit=1] train.id
	execute as @e[tag=tt.a,limit=1] run function train:sample/root_of
	scoreboard players operation #r0 train_test = #root train.tmp
	execute as @e[tag=tt.b,limit=1] run function train:sample/root_of
	scoreboard players operation #r1 train_test = #root train.tmp
	execute as @e[tag=tt.c,limit=1] run function train:sample/root_of
	scoreboard players operation #r2 train_test = #root train.tmp
	execute unless score #r0 train_test = #aid train_test run scoreboard players set #ok train_test 0
	execute unless score #r1 train_test = #aid train_test run scoreboard players set #ok train_test 0
	execute if score #r2 train_test = #aid train_test run scoreboard players set #ok train_test 0
	execute unless score #r2 train_test matches 1.. run scoreboard players set #ok train_test 0
}
#endregion

#region Task 1 shared state
# Objectives and constants exist, every minecart type is a train cart
function self_check {
	scoreboard players set #ok train_test 1
	REPEAT(0, 6) as i {
		<%%
		const names = ["train.ppx", "train.ppz", "train.svx", "train.svz", "train.dir", "train.gap", "train.chk"];
		emit.mcb(`execute store success score #x train_test run scoreboard players set #probe ${names[i]} 1`);
		emit.mcb(`execute unless score #x train_test matches 1 run scoreboard players set #ok train_test 0`);
		%%>
	}
	execute unless score #period train.const matches 20 run scoreboard players set #ok train_test 0
	execute unless score #reach train.const matches 16 run scoreboard players set #ok train_test 0
	execute unless score #stop train.const matches <%u(2.5)%> run scoreboard players set #ok train_test 0
	execute unless score #hit train.const matches <%u(0.1)%> run scoreboard players set #ok train_test 0
	execute unless score #10 train.const matches 10 run scoreboard players set #ok train_test 0
	execute unless score #noavoid train.const matches 0 run scoreboard players set #ok train_test 0

	execute at @e[tag=tt.origin,limit=1] run summon minecraft:hopper_minecart ~ ~ ~ {Tags:["tt","tt.probe"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:tnt_minecart ~ ~ ~ {Tags:["tt","tt.probe"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:spawner_minecart ~ ~ ~ {Tags:["tt","tt.probe"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:command_block_minecart ~ ~ ~ {Tags:["tt","tt.probe"]}
	execute store result score #n train_test if entity @e[type=#train:carts,tag=tt.probe]
	execute unless score #n train_test matches 4 run scoreboard players set #ok train_test 0

}
#endregion

#region Deferred minors
# t21 two followers of one leader. A trace marks the whole own train by walking the followers with #cur, which each visit overwrites. That is
# safe because execute tests every source's if before any run starts, so both siblings are matched against the leader's id first. A test
# and not a fix: a sibling missed here would read as a foreign cart. The cart behind both is 6 blocks along
function t21/run {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run {
		fill ~ ~ ~ ~8 ~ ~ minecraft:rail[shape=east_west]
		summon minecraft:furnace_minecart ~ ~ ~ {Tags:["tt","tt.h"]}
		summon minecraft:minecart ~2 ~ ~ {Tags:["tt","tt.f"]}
		summon minecraft:minecart ~3 ~ ~ {Tags:["tt","tt.g"]}
		summon minecraft:minecart ~6 ~ ~ {Tags:["tt","tt.x"]}
	}
	scoreboard players set @e[tag=tt.h,limit=1] train.dir 1
	execute as @e[tag=tt.h,limit=1] run function train:link/assign_id
	execute as @e[tag=tt.f,limit=1] run function train:link/assign_id
	execute as @e[tag=tt.g,limit=1] run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.h,limit=1] train.id
	execute as @e[tag=tt.f,limit=1] run function train:link/apply
	execute as @e[tag=tt.g,limit=1] run function train:link/apply
	scoreboard players set #want train_test <%6 * UNIT%>
	scoreboard players set #ok train_test 1
	function train_test:trace/shoot
}

# t22 a snap to the rail center is not a speed. The sampler reads the move as velocity unless the snap resyncs it, and a head at 0.4 off
# center would read 0.4 for one tick, enough to look like a hard hit. The head sits at x.4 and snaps to x.5, the sampler is run on both sides
function t22/run {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~3.9 ~ ~ {Tags:["tt","tt.h"]}
	execute as @e[tag=tt.h,limit=1] at @s run function train:sample/cart
	execute as @e[tag=tt.h,limit=1] run function train:head/snap
	execute as @e[tag=tt.h,limit=1] at @s run function train:sample/cart
	scoreboard players set #ok train_test 1
	execute unless entity @e[tag=tt.h,scores={train.svx=0,train.svz=0}] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.h,scores={train.halt=1}] run scoreboard players set #ok train_test 0
}

# t23 gap aging. Per tick the gap shrinks by the distance travelled along the heading and not at all when the head drifts the other way,
# a held head on a slope rolls back and used to eat its own gap. Cases: heading, vx, vz, gap before, gap after. Forward is the larger axis
# plus 0.4 of the smaller, never below 0
<%%
const age = (heading, vx, vz, gap) => {
	const big = Math.max(Math.abs(vx), Math.abs(vz));
	const small = Math.floor(Math.min(Math.abs(vx), Math.abs(vz)) * 4 / 10);
	const forward = (heading === 1 && vx > 0) || (heading === 3 && vx < 0) || (heading === 2 && vz > 0) || (heading === 0 && vz < 0);
	return forward ? Math.max(0, gap - big - small) : gap;
};
const g = u(10);
const CASES = [
	[1, u(0.3), 0, g], [1, -u(0.3), 0, g], [1, u(0.3), u(0.2), g], [1, u(0.3), -u(0.2), g], [1, 0, 0, g], [1, u(0.3), 0, u(0.1)],
	[3, -u(0.3), 0, g], [3, u(0.3), 0, g],
	[2, 0, u(0.3), g], [2, 0, -u(0.3), g],
	[0, 0, -u(0.3), g], [0, 0, u(0.3), g],
];
const lines = [
	"\tfunction train_test:lib/begin",
	"\tfunction train_test:lib/flat",
	"\texecute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~3 ~ ~ {Tags:[\"tt\",\"tt.h\"]}",
	"\tscoreboard players set #ok train_test 1",
];
CASES.forEach(([heading, vx, vz, gap], i) => {
	lines.push(`\tscoreboard players set @e[tag=tt.h,limit=1] train.dir ${heading}`);
	lines.push(`\tscoreboard players set @e[tag=tt.h,limit=1] train.svx ${vx}`);
	lines.push(`\tscoreboard players set @e[tag=tt.h,limit=1] train.svz ${vz}`);
	lines.push(`\tscoreboard players set @e[tag=tt.h,limit=1] train.gap ${gap}`);
	lines.push("\texecute as @e[tag=tt.h,limit=1] run function train:avoid/age");
	lines.push(`\texecute unless entity @e[tag=tt.h,scores={train.gap=${age(heading, vx, vz, gap)}}] run scoreboard players set #ok train_test 0`);
	lines.push(`\texecute unless entity @e[tag=tt.h,scores={train.gap=${age(heading, vx, vz, gap)}}] run say gt dump age case ${i} FAIL heading ${heading} v ${vx} ${vz} gap ${gap} want ${age(heading, vx, vz, gap)}`);
});
emit.mcb("function t23/run {\n" + lines.join("\n") + "\n}");
%%>

# t24 a hard hit that vanilla's minecart push had already slowed. Within about 1.18 blocks the push cuts both carts to a fifth of their
# motion, so the sampler reads the tick after a 0.3 closing as nearly 0 and the pair is inside the scan radius. The sampler keeps last tick's
# velocity too and the larger relative speed of the two decides. Last tick 0.3 against 0.3, now both carts read 0
function t24/run {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~10 ~ ~ {Tags:["tt","tt.a"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~11 ~ ~ {Tags:["tt","tt.b"]}
	function train_test:lib/hard_closing
	scoreboard players operation @e[tag=tt.a,limit=1] train.pvx = @e[tag=tt.a,limit=1] train.svx
	scoreboard players operation @e[tag=tt.b,limit=1] train.pvx = @e[tag=tt.b,limit=1] train.svx
	scoreboard players set @e[tag=tt.a,limit=1] train.pvz 0
	scoreboard players set @e[tag=tt.b,limit=1] train.pvz 0
	scoreboard players set @e[tag=tt.a,limit=1] train.svx 0
	scoreboard players set @e[tag=tt.b,limit=1] train.svx 0
	function train:crash/tick
	scoreboard players set #ok train_test 1
	execute if entity @e[type=minecraft:furnace_minecart,tag=tt] run scoreboard players set #ok train_test 0
	execute store result score #n train_test at @e[tag=tt.origin,limit=1] if entity @e[type=minecraft:item,nbt={Item:{id:"minecraft:furnace_minecart"}},distance=..64]
	execute unless score #n train_test matches 2 run scoreboard players set #ok train_test 0
}

# t24 again with the carts on rails one block apart. Last tick hard, now both read 0, and the sideways offset of 1.0 still says they passed
# without touching, the pair has to use the same offset check on whichever velocity it picked
function t24/parallel {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~10 ~ ~ {Tags:["tt","tt.a"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~10.3 ~ ~1 {Tags:["tt","tt.b"]}
	function train_test:lib/hard_closing
	scoreboard players operation @e[tag=tt.a,limit=1] train.pvx = @e[tag=tt.a,limit=1] train.svx
	scoreboard players operation @e[tag=tt.b,limit=1] train.pvx = @e[tag=tt.b,limit=1] train.svx
	scoreboard players set @e[tag=tt.a,limit=1] train.pvz 0
	scoreboard players set @e[tag=tt.b,limit=1] train.pvz 0
	scoreboard players set @e[tag=tt.a,limit=1] train.svx 0
	scoreboard players set @e[tag=tt.b,limit=1] train.svx 0
	function train:crash/tick
	scoreboard players set #ok train_test 1
	execute unless entity @e[tag=tt.a] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.b] run scoreboard players set #ok train_test 0
}

# Powered rail, unpowered, at block 11 of the strip. The cart ahead is 14 along, a head from 3 starts yielding about 4.5 blocks out, at 9.5,
# so it is already braking when it reaches the rail
function lib/rail_stage {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	function train_test:lib/head
	execute at @e[tag=tt.origin,limit=1] run setblock ~11 ~ ~ minecraft:powered_rail[powered=false,shape=east_west]
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~14 ~ ~ {Tags:["tt","tt.x"]}
}

# t25 an unpowered powered rail wins over yielding. The head is already braking when it reaches the rail, it stops on the center of the block
# and stays there, and when the rail gets power it goes on and yields to the cart again, 3 blocks on
function t25/start {
	function train_test:lib/rail_stage
}
function t25/at_rail {
	scoreboard players set #ok train_test 1
	execute unless entity @e[tag=tt.h,scores={train.halt=1}] run scoreboard players set #ok train_test 0
	execute store result score #hx train_test run data get entity @e[tag=tt.h,limit=1] Pos[0] <%UNIT%>
	execute unless score #hx train_test matches <%u(111.4)%>..<%u(111.6)%> run scoreboard players set #ok train_test 0
}
function t25/power {
	execute at @e[tag=tt.origin,limit=1] run setblock ~11 ~ ~1 minecraft:redstone_block
}
function t25/check {
	function train_test:lib/stopped_short
}

# t26 avoid leaves a head alone while a rail holds it, halt 1 stopped or 2 coasting, even with a cart 2 blocks ahead. One call, and the
# head must not have been traced either
function t26/run {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~3 ~ ~ {Tags:["tt","tt.h"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~5 ~ ~ {Tags:["tt","tt.x"]}
	scoreboard players set @e[tag=tt.h,limit=1] train.dir 1
	scoreboard players set #ok train_test 1
	scoreboard players set @e[tag=tt.h,limit=1] train.halt 1
	execute as @e[tag=tt.h,limit=1] at @s run function train:avoid/head
	execute unless entity @e[tag=tt.h,scores={train.halt=1}] run scoreboard players set #ok train_test 0
	execute if score @e[tag=tt.h,limit=1] train.gap matches -2147483648..2147483647 run scoreboard players set #ok train_test 0
	scoreboard players set @e[tag=tt.h,limit=1] train.halt 2
	execute as @e[tag=tt.h,limit=1] at @s run function train:avoid/head
	execute unless entity @e[tag=tt.h,scores={train.halt=2}] run scoreboard players set #ok train_test 0
	execute if score @e[tag=tt.h,limit=1] train.gap matches -2147483648..2147483647 run scoreboard players set #ok train_test 0
}

# Head tt.h with two coupled followers, tt.f then tt.g. The follower kinds come from the caller through the summon lines of the tests
function lib/couple_three {
	execute as @e[tag=tt.h,limit=1] run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.h,limit=1] train.id
	execute as @e[tag=tt.f,limit=1] run function train:link/apply
	execute as @e[tag=tt.f,limit=1] run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.f,limit=1] train.id
	execute as @e[tag=tt.g,limit=1] run function train:link/apply
}

# Spacing of h to f and f to g is about 2 blocks, and f is behind h and g behind f
function lib/spacing_check {
	execute store result score #hx train_test run data get entity @e[tag=tt.h,limit=1] Pos[0] <%UNIT%>
	execute store result score #fx train_test run data get entity @e[tag=tt.f,limit=1] Pos[0] <%UNIT%>
	execute store result score #gx train_test run data get entity @e[tag=tt.g,limit=1] Pos[0] <%UNIT%>
	scoreboard players operation #d1 train_test = #hx train_test
	scoreboard players operation #d1 train_test -= #fx train_test
	scoreboard players operation #d2 train_test = #fx train_test
	scoreboard players operation #d2 train_test -= #gx train_test
	execute unless score #d1 train_test matches <%u(1.65)%>..<%u(2.35)%> run scoreboard players set #ok train_test 0
	execute unless score #d2 train_test matches <%u(1.65)%>..<%u(2.35)%> run scoreboard players set #ok train_test 0
}

# t27 a head with two followers moving at speed brakes for a parked cart, the followers close up behind it one after the other and nothing
# explodes or drops. Followers are plain minecarts here
function t27/start {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	function train_test:lib/head
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~1 ~ ~ {Tags:["tt","tt.f"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~-1 ~ ~ {Tags:["tt","tt.g"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~30 ~ ~ {Tags:["tt","tt.x"]}
	function train_test:lib/couple_three
}
function t27/check {
	function train_test:lib/stopped_short
	execute unless entity @e[tag=tt.f] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.g] run scoreboard players set #ok train_test 0
	function train_test:lib/spacing_check
}

# t28 the same with a furnace as the follower, fueled and pushing, starting 0.6 behind its head inside the 1.15 scan radius. Two furnaces of
# one train touching, then braking together, must not explode. Taking out the same-train rule does not fail this one, the follower never
# closes at 0.1 per tick in real motion, t12 pins the rule with a hand set closing speed. This one guards the whole train settling
function t28/start {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	function train_test:lib/head
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~2.4 ~ ~ {Tags:["tt","tt.f"],Fuel:3000s,PushX:1.0d,PushZ:0.0d}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~0.5 ~ ~ {Tags:["tt","tt.g"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~30 ~ ~ {Tags:["tt","tt.x"]}
	function train_test:lib/couple_three
}
function t28/check {
	function train_test:lib/stopped_short
	execute unless entity @e[tag=tt.f] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.g] run scoreboard players set #ok train_test 0
}
#endregion

#region Chunk claims
# A coupled train claims the chunks its 15x15 squares touch, far from the arena so the claims are not the arena's own forced chunks. The
# head at x 3012.5 and the follower at x 3010.5, z 3004.5, touch chunks 187 and 188 on both axes. The gametest pack forceloads chunk 188 187 itself,
# see gt_tick in generate.js, so that one is already forced and never ours to free, the other three are. A derail frees all of ours and leaves the test's alone
function chunk/start {
	function train_test:lib/cleanup
	kill @e[tag=tt.origin]
	scoreboard players set #noavoid train.const 0
	scoreboard players set #ok train_test 1
	execute unless loaded 3010 64 3004 run scoreboard players set #ok train_test 0
	execute positioned 3010.5 64 3004.5 run summon minecraft:marker ~ ~ ~ {Tags:["tt","tt.origin"]}
	execute at @e[tag=tt.origin,limit=1] run fill ~-1 ~-1 ~ ~5 ~-1 ~ minecraft:stone
	execute at @e[tag=tt.origin,limit=1] run fill ~-1 ~ ~ ~5 ~3 ~ minecraft:air
	execute at @e[tag=tt.origin,limit=1] run fill ~-1 ~ ~ ~5 ~ ~ minecraft:rail[shape=east_west]
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:furnace_minecart ~2 ~ ~ {Tags:["tt","tt.h"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~ ~ ~ {Tags:["tt","tt.f"]}
	execute as @e[tag=tt.h,limit=1] run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.h,limit=1] train.id
	execute as @e[tag=tt.f,limit=1] run function train:link/apply
}
function chunk/claimed {
	scoreboard players set #ok train_test 1
	execute in minecraft:overworld store success score #q train_test run forceload query 2992 3004
	execute unless score #q train_test matches 1 run scoreboard players set #ok train_test 0
	execute in minecraft:overworld store success score #q train_test run forceload query 2992 3008
	execute unless score #q train_test matches 1 run scoreboard players set #ok train_test 0
	execute in minecraft:overworld store success score #q train_test run forceload query 3008 3008
	execute unless score #q train_test matches 1 run scoreboard players set #ok train_test 0
	execute in minecraft:overworld store success score #q train_test run forceload query 3008 3004
	execute unless score #q train_test matches 1 run scoreboard players set #ok train_test 0
	# A chunk no square reaches is not claimed
	execute in minecraft:overworld store success score #q train_test run forceload query 2976 3004
	execute unless score #q train_test matches 0 run scoreboard players set #ok train_test 0
}
function chunk/derail {
	execute at @e[tag=tt.origin,limit=1] run setblock ~ ~ ~ minecraft:air
}
function chunk/released {
	scoreboard players set #ok train_test 1
	execute in minecraft:overworld store success score #q train_test run forceload query 2992 3004
	execute unless score #q train_test matches 0 run scoreboard players set #ok train_test 0
	execute in minecraft:overworld store success score #q train_test run forceload query 2992 3008
	execute unless score #q train_test matches 0 run scoreboard players set #ok train_test 0
	execute in minecraft:overworld store success score #q train_test run forceload query 3008 3008
	execute unless score #q train_test matches 0 run scoreboard players set #ok train_test 0
	execute in minecraft:overworld store success score #q train_test run forceload query 3008 3004
	execute unless score #q train_test matches 1 run scoreboard players set #ok train_test 0
	function train_test:lib/cleanup
}
#endregion

#region Chain breaking
# Macro, id. A chain display for the follower tt.f as chain/spawn makes it, tagged and scored like the real one, of the block in id
function lib/chain_display {
	execute at @e[tag=tt.f,limit=1] run summon minecraft:block_display ~ ~0.4 ~ {Tags:["tt","tt.d","train.chain"],teleport_duration:1,interpolation_duration:1}
	scoreboard players operation @e[tag=tt.d,limit=1] train.id = @e[tag=tt.f,limit=1] train.id
	$data modify entity @e[tag=tt.d,limit=1] block_state set value "$(id)"
}

# Follower tt.f on the strip at x 3 coupled to a parked minecart tt.h at x 9, 6 blocks away, with a copper chain between them.
# A copper chain and not an iron one, a drop that is always iron would pass otherwise
function lib/far_pair {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~3 ~ ~ {Tags:["tt","tt.f"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~9 ~ ~ {Tags:["tt","tt.h"]}
	execute as @e[tag=tt.h,limit=1] run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.h,limit=1] train.id
	execute as @e[tag=tt.f,limit=1] run function train:link/apply
	execute as @e[tag=tt.f,limit=1] run function train:link/assign_id
	function train_test:lib/chain_display {id:"minecraft:copper_chain"}
}

# t30 a follower that can't close a 6 block gap loses the chain. Stone on the strip at x 4 stops it, the head is parked past it. The gap is
# over 5 blocks every tick, and the chain holds for the first ticks and then breaks and drops a copper chain, not an iron one
function t30/start {
	function train_test:lib/far_pair
	execute at @e[tag=tt.origin,limit=1] run setblock ~4 ~ ~ minecraft:stone
}
function t30/still {
	execute unless entity @e[tag=tt.f,tag=train.follower] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.d] run scoreboard players set #ok train_test 0
}
function t30/check {
	execute if entity @e[tag=tt.f,tag=train.follower] run scoreboard players set #ok train_test 0
	execute if entity @e[tag=tt.d] run scoreboard players set #ok train_test 0
	execute at @e[tag=tt.origin,limit=1] unless entity @e[type=minecraft:item,distance=..64,nbt={Item:{id:"minecraft:copper_chain"}}] run scoreboard players set #ok train_test 0
	execute at @e[tag=tt.origin,limit=1] if entity @e[type=minecraft:item,distance=..64,nbt={Item:{id:"minecraft:iron_chain"}}] run scoreboard players set #ok train_test 0
}

# t31 a gap that is over 5 blocks for only a moment does not break the chain. The same pair on open track, the follower closes the 6 blocks
# at 0.45 a tick and is under 5 well inside the 5 ticks
function t31/start {
	function train_test:lib/far_pair
}
function t31/check {
	execute unless entity @e[tag=tt.f,tag=train.follower] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.d] run scoreboard players set #ok train_test 0
	execute at @e[tag=tt.origin,limit=1] if entity @e[type=minecraft:item,distance=..64,nbt={Item:{id:"minecraft:copper_chain"}}] run scoreboard players set #ok train_test 0
}

# t32 a cut by a creative player drops nothing. uncouple sets #nodrop before it unlinks, here it is set by hand. The chain is gone, the
# follower is free and no chain item lies around
function t32/start {
	function train_test:lib/far_pair
	scoreboard players set #nodrop train.tmp 1
	execute as @e[tag=tt.f,limit=1] run function train:link/unlink
	scoreboard players set #nodrop train.tmp 0
}
function t32/check {
	execute if entity @e[tag=tt.f,tag=train.follower] run scoreboard players set #ok train_test 0
	execute if entity @e[tag=tt.d] run scoreboard players set #ok train_test 0
	execute at @e[tag=tt.origin,limit=1] if entity @e[type=minecraft:item,distance=..64] run scoreboard players set #ok train_test 0
}
#endregion

#region Crossed links
# t43 a link whose chord runs through another cart of the same train. Carts a b c in a row on the strip, a leads b, then c leads a, so the
# chain order is c a b and a is pulled through b toward c. b is kicked toward c. Nothing feeds this, so every cart has to be at rest well
# before the end, or the second link was refused. Unfixed, the three accelerate to 0.4 a tick and run off the 45 block strip around tick 80,
# so positions are marked at tick 40 and compared at 70, while they are still on the rail. The kick alone coasts about 1 block in that window,
# so the limit is 2
function t43/start {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~6 ~ ~ {Tags:["tt","tt.a"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~8 ~ ~ {Tags:["tt","tt.b"],Motion:[0.3d,0.0d,0.0d]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~10 ~ ~ {Tags:["tt","tt.c"]}
	execute as @e[tag=tt.a,limit=1] run function train:link/assign_id
	execute as @e[tag=tt.b,limit=1] run function train:link/assign_id
	execute as @e[tag=tt.c,limit=1] run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.a,limit=1] train.id
	execute as @e[tag=tt.b,limit=1] run function train:link/apply
	scoreboard players operation #lead train.tmp = @e[tag=tt.c,limit=1] train.id
	execute as @e[tag=tt.a,limit=1] run function train:link/apply
}
function t43/mark {
	execute store result score #pa train_test run data get entity @e[tag=tt.a,limit=1] Pos[0] <%UNIT%>
	execute store result score #pb train_test run data get entity @e[tag=tt.b,limit=1] Pos[0] <%UNIT%>
	execute store result score #pc train_test run data get entity @e[tag=tt.c,limit=1] Pos[0] <%UNIT%>
}
function t43/check {
	execute unless entity @e[tag=tt.a] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.b] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.c] run scoreboard players set #ok train_test 0
	execute store result score #qa train_test run data get entity @e[tag=tt.a,limit=1] Pos[0] <%UNIT%>
	execute store result score #qb train_test run data get entity @e[tag=tt.b,limit=1] Pos[0] <%UNIT%>
	execute store result score #qc train_test run data get entity @e[tag=tt.c,limit=1] Pos[0] <%UNIT%>
	scoreboard players operation #qa train_test -= #pa train_test
	scoreboard players operation #qb train_test -= #pb train_test
	scoreboard players operation #qc train_test -= #pc train_test
	execute unless score #qa train_test matches -<%u(2)%>..<%u(2)%> run scoreboard players set #ok train_test 0
	execute unless score #qb train_test matches -<%u(2)%>..<%u(2)%> run scoreboard players set #ok train_test 0
	execute unless score #qc train_test matches -<%u(2)%>..<%u(2)%> run scoreboard players set #ok train_test 0
}
#endregion

#region Corners and parallel pulls
# Follower tt.f relative to the origin marker, in units. Leaves #rx and #rz in train_test
function lib/rel_f {
	execute store result score #fx train_test run data get entity @e[tag=tt.f,limit=1] Pos[0] <%UNIT%>
	execute store result score #fz train_test run data get entity @e[tag=tt.f,limit=1] Pos[2] <%UNIT%>
	execute store result score #ox train_test run data get entity @e[tag=tt.origin,limit=1] Pos[0] <%UNIT%>
	execute store result score #oz train_test run data get entity @e[tag=tt.origin,limit=1] Pos[2] <%UNIT%>
	scoreboard players operation #rx train_test = #fx train_test
	scoreboard players operation #rx train_test -= #ox train_test
	scoreboard players operation #rz train_test = #fz train_test
	scoreboard players operation #rz train_test -= #oz train_test
}

# Head tt.h with one coupled follower tt.f, a plain cart
function lib/couple_two {
	execute as @e[tag=tt.h,limit=1] run function train:link/assign_id
	scoreboard players operation #lead train.tmp = @e[tag=tt.h,limit=1] train.id
	execute as @e[tag=tt.f,limit=1] run function train:link/apply
}

# t33 a hairpin. East along z 0 to x 10, a U with its legs 2 apart, then west along z 2. The chord from the follower on the first leg to the
# head on the return leg points back along the follower's own track, and the rail flips a cart whose Motion opposes it. The follower must
# never roll backward on the first leg, and must come round the U still coupled. Written before the fix, fails on the current follow.mcb
function t33/start {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run fill ~ ~ ~ ~10 ~ ~ minecraft:rail[shape=east_west]
	execute at @e[tag=tt.origin,limit=1] run fill ~ ~ ~2 ~10 ~ ~2 minecraft:rail[shape=east_west]
	execute at @e[tag=tt.origin,limit=1] run setblock ~11 ~ ~ minecraft:rail[shape=south_west]
	execute at @e[tag=tt.origin,limit=1] run setblock ~11 ~ ~1 minecraft:rail[shape=north_south]
	execute at @e[tag=tt.origin,limit=1] run setblock ~11 ~ ~2 minecraft:rail[shape=north_west]
	function train_test:lib/head
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~1 ~ ~ {Tags:["tt","tt.f"]}
	function train_test:lib/couple_two
	# Furthest east the follower has been on the first leg. Nothing real is below -10
	scoreboard players set #maxx train_test -<%u(10)%>
}
# On the first leg, through the curve block at its end, x only grows. 0.15 is slack for a vanilla shove
function t33/watch {
	function train_test:lib/rel_f
	execute if score #rz train_test matches ..<%u(1.0) - 1%> if score #rx train_test > #maxx train_test run scoreboard players operation #maxx train_test = #rx train_test
	scoreboard players operation #back train_test = #maxx train_test
	scoreboard players operation #back train_test -= #rx train_test
	execute if score #rz train_test matches ..<%u(1.0) - 1%> if score #back train_test matches <%u(0.15) + 1%>.. run scoreboard players set #ok train_test 0
}
# The follower made the turn, it is on the return leg, and the chain held
function t33/end {
	function train_test:lib/rel_f
	execute unless score #rz train_test matches <%u(1.5)%>.. run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.f,tag=train.follower] run scoreboard players set #ok train_test 0
}

# t34 pulling a cart along a parallel track. The strips are 3 apart and not connected, so the follower's rails never lead to the head and the
# straight line to it is the only signal there is. It starts 3 ahead of the head, so it is dragged backward along its own track, then
# follows it east once the head has passed. A rule that never reverses a follower breaks the first half
function t34/start {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	execute at @e[tag=tt.origin,limit=1] run fill ~ ~ ~3 ~44 ~ ~3 minecraft:rail[shape=east_west]
	function train_test:lib/head
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~6 ~ ~3 {Tags:["tt","tt.f"]}
	function train_test:lib/couple_two
}
function t34/dragged {
	function train_test:lib/rel_f
	execute unless score #rx train_test matches ..<%u(5.3)%> run scoreboard players set #ok train_test 0
}
function t34/pulled {
	function train_test:lib/rel_f
	execute unless score #rx train_test matches <%u(15)%>.. run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.f,tag=train.follower] run scoreboard players set #ok train_test 0
}

# Bunching. Coupled carts never get closer than half a block, center to center, at any poll. A fix to the follower controller once
# made followers squeeze together. Straight line distance, so it holds on a bend too. h to f and f to g, #ok goes to 0 on a squeeze
function lib/pair_gap {
	scoreboard players operation #pdx train_test = #pax train_test
	scoreboard players operation #pdx train_test -= #pbx train_test
	scoreboard players operation #pdz train_test = #paz train_test
	scoreboard players operation #pdz train_test -= #pbz train_test
	scoreboard players operation #pdx train_test *= #pdx train_test
	scoreboard players operation #pdz train_test *= #pdz train_test
	scoreboard players operation #pdx train_test += #pdz train_test
	execute if score #pdx train_test matches ..<%u(0.5) ** 2 - 1%> run scoreboard players set #ok train_test 0
}
function bunch/watch {
	execute store result score #pax train_test run data get entity @e[tag=tt.h,limit=1] Pos[0] <%UNIT%>
	execute store result score #paz train_test run data get entity @e[tag=tt.h,limit=1] Pos[2] <%UNIT%>
	execute store result score #pbx train_test run data get entity @e[tag=tt.f,limit=1] Pos[0] <%UNIT%>
	execute store result score #pbz train_test run data get entity @e[tag=tt.f,limit=1] Pos[2] <%UNIT%>
	function train_test:lib/pair_gap
	execute store result score #pax train_test run data get entity @e[tag=tt.f,limit=1] Pos[0] <%UNIT%>
	execute store result score #paz train_test run data get entity @e[tag=tt.f,limit=1] Pos[2] <%UNIT%>
	execute store result score #pbx train_test run data get entity @e[tag=tt.g,limit=1] Pos[0] <%UNIT%>
	execute store result score #pbz train_test run data get entity @e[tag=tt.g,limit=1] Pos[2] <%UNIT%>
	function train_test:lib/pair_gap
	execute unless entity @e[tag=tt.f,tag=train.follower] run scoreboard players set #ok train_test 0
	execute unless entity @e[tag=tt.g,tag=train.follower] run scoreboard players set #ok train_test 0
}

# t35 a head with two followers brakes for a parked cart on a straight, the followers close up behind it
function t35/start {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:lib/strip
	function train_test:lib/head
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~1 ~ ~ {Tags:["tt","tt.f"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~-1 ~ ~ {Tags:["tt","tt.g"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~30 ~ ~ {Tags:["tt","tt.x"]}
	function train_test:lib/couple_three
}
function t35/check {
	function train_test:lib/stopped_short
	function train_test:bunch/watch
}

# t36 the same through the hairpin of t33, the parked cart on the return leg. The followers close up around the U, where the detour drives
# them along the rails and not by the chord
function t36/start {
	function train_test:lib/begin
	function train_test:lib/flat
	execute at @e[tag=tt.origin,limit=1] run fill ~ ~ ~ ~10 ~ ~ minecraft:rail[shape=east_west]
	execute at @e[tag=tt.origin,limit=1] run fill ~ ~ ~2 ~10 ~ ~2 minecraft:rail[shape=east_west]
	execute at @e[tag=tt.origin,limit=1] run setblock ~11 ~ ~ minecraft:rail[shape=south_west]
	execute at @e[tag=tt.origin,limit=1] run setblock ~11 ~ ~1 minecraft:rail[shape=north_south]
	execute at @e[tag=tt.origin,limit=1] run setblock ~11 ~ ~2 minecraft:rail[shape=north_west]
	function train_test:lib/head
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~1 ~ ~ {Tags:["tt","tt.f"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~-1 ~ ~ {Tags:["tt","tt.g"]}
	execute at @e[tag=tt.origin,limit=1] run summon minecraft:minecart ~2 ~ ~2 {Tags:["tt","tt.x"]}
	function train_test:lib/couple_three
}
function t36/check {
	function train_test:bunch/watch
}
#endregion

#region Gametest poll functions
# t0 as a scenario, the stage first
function t0/run {
	function train_test:lib/begin
	function train_test:lib/flat
	function train_test:self_check
}

# One poll function per test, run every tick by the repeating command block of its structure, at the command block. A marker at the block
# counts ticks. A step that leaves #ok at 0 powers the fail block, the last step passing powers the accept block. Redstone goes at ~5 ~1 ~
# for fail and ~3 ~1 ~ for accept, above the test blocks of the scaffold, see gametest/generate.js. A test removes its own command block when
# it ends. The runner clears a finished test's entities, and a command block left running would count from 0 again and replay the scenario
# over whichever test is running now. Every step prints its result once
<%%
for (const t of gametest.tests) {
	const last = Math.max(...t.steps.map(([age]) => age));
	const lines = [
		// The test's window on the global clock, which only runs once the arena is loaded. An unset #clock is not in any range
		`\texecute unless score #clock train_test matches ${t.start}.. run return 0`,
		"\texecute unless entity @e[type=minecraft:marker,tag=gt.mark,distance=..0.6] run summon minecraft:marker ~ ~ ~ {Tags:[\"gt.mark\"]}",
		"\tscoreboard players add @e[type=minecraft:marker,tag=gt.mark,distance=..0.6] gt.age 1",
		"\tscoreboard players operation #age train_test = @e[type=minecraft:marker,tag=gt.mark,distance=..0.6,limit=1] gt.age",
	];
	t.steps.forEach(([age, fn], i) => {
		lines.push(`\texecute if score #age train_test matches ${age} run function train_test:gt/${t.id}_${i}`);
		const body = [
			`\tsay gt run ${t.id} step ${i + 1}`,
			"\tscoreboard players set #ok train_test 1",
			`\tfunction train_test:${fn}`,
			`\tdata modify storage train_test:cur name set value "${t.id} step ${i + 1} of ${t.steps.length}"`,
			"\texecute unless score #ok train_test matches 1 run function train_test:lib/report with storage train_test:cur",
			"\texecute unless score #ok train_test matches 1 run function train_test:lib/dump",
			"\texecute unless score #ok train_test matches 1 run setblock ~5 ~1 ~ minecraft:redstone_block",
			"\texecute unless score #ok train_test matches 1 run setblock ~ ~ ~ minecraft:air",
		];
		if (age === last) {
			body.push(`\tdata modify storage train_test:cur name set value "${t.id}"`);
			body.push("\texecute if score #ok train_test matches 1 run function train_test:lib/report with storage train_test:cur");
			body.push("\texecute if score #ok train_test matches 1 run setblock ~3 ~1 ~ minecraft:redstone_block");
			body.push("\texecute if score #ok train_test matches 1 run setblock ~ ~ ~ minecraft:air");
		}
		emit.mcb(`function gt/${t.id}_${i} {\n${body.join("\n")}\n}`);
	});
	emit.mcb(`function gt/${t.id} {\n${lines.join("\n")}\n}`);
}
%%>
#endregion
